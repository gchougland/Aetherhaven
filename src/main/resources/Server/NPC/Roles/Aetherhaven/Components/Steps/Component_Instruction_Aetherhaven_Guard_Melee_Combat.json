            }
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Or",
              "Sensors": [
                {
                  "Type": "Target",
                  "Range": {
                    "Compute": "ViewRange"
                  },
                  "Filters": [
                    {
                      "Type": "LineOfSight"
                    }
