        "BodyMotion": {
          "Type": "Seek",
          "SlowDownDistance": 8,
          "StopDistance": 1.8,
          "RelativeSpeed": 1.0,
          "UsePathfinder": true,
          "UseSteering": true,
          "AbortDistance": 48,
          "MaxPathLength": 400,
          "MaxTotalNodes": 1200
