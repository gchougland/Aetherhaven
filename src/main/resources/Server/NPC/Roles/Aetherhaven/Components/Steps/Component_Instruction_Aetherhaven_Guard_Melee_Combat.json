      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Or",
          "Sensors": [
            {
              "Type": "Target",
              "Range": {
                "Compute": "CombatBehaviorDistance"
              },
              "Filters": [
                {
                  "Type": "LineOfSight"
                }
              ]
            },
            {
              "Type": "Target",
              "TargetSlot": "LockedTarget",
              "Range": {
                "Compute": "CombatBehaviorDistance"
              },
              "Filters": [
                {
                  "Type": "LineOfSight"
                }
              ]
            }
          ]
        },
        "BodyMotion": {
          "Type": "MaintainDistance",
          "DesiredDistanceRange": {
            "Compute": "DesiredAttackDistanceRange"
          },
          "MoveThreshold": 0.25,
          "StrafingDurationRange": {
            "Compute": "StrafingDurationRange"
          },
          "StrafingFrequencyRange": {
            "Compute": "StrafingFrequencyRange"
          },
          "RelativeForwardsSpeed": 0.75,
          "RelativeBackwardsSpeed": 0.4
        }
      }
    ]
