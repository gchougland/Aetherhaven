{
  "Type": "Component",
  "Class": "Instruction",
  "Interface": "Hytale.Instruction",
  "$Comment": "Melee combat: Seek to close from detection range, then maintain distance and attack.",
  "Parameters": {
    "ViewRange": {
      "Value": 24,
      "Description": "Combat awareness range"
    },
    "AttackDistance": {
      "Value": 3.0,
      "Description": "Melee attack range"
    },
    "DesiredAttackDistanceRange": {
      "Value": [
        1.5,
        2.2
      ],
      "Description": "Preferred melee engagement band"
    },
    "CombatBehaviorDistance": {
      "Value": 24,
      "Description": "Distance within which combat positioning runs"
    },
    "StrafingDurationRange": {
      "Value": [
        0.4,
        1
      ],
      "Description": "How long to strafe while maintaining distance"
    },
    "StrafingFrequencyRange": {
      "Value": [
        0.5,
        1.5
      ],
      "Description": "How often to strafe while maintaining distance"
    },
    "MeleeAttack": {
      "Value": "Root_NPC_Attack_Melee",
      "Description": "Melee attack interaction root"
    },
    "AttackPauseRange": {
      "Value": [
        1,
        2
      ],
      "Description": "Pause between melee swings"
    },
    "CombatAttackPreDelay": {
      "Value": [
        0.15,
        0.35
      ],
      "Description": "Brief stop before swinging so the hit connects"
    }
  },
  "Content": {
    "Instructions": [
      {
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "AetherhavenGuardAutomaticAggro"
            },
            {
              "Type": "Damage",
