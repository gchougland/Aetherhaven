                {
                  "Type": "Target",
                  "TargetSlot": "LockedTarget",
                  "Range": {
                    "Compute": "ViewRange"
                  },
                  "Filters": [
                    {
                      "Type": "LineOfSight"
                    }
                  ]
                }
              ]
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Or",
                "Sensors": [
                  {
                    "Type": "Target",
                    "Range": {
                      "Compute": "AttackDistance"
                    },
                    "Filters": [
                      {
                        "Type": "LineOfSight"
                      }
                    ]
                  },
                  {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget",
                    "Range": {
                      "Compute": "AttackDistance"
                    },
                    "Filters": [
                      {
                        "Type": "LineOfSight"
                      }
                    ]
                  }
                ]
              }
            }
          ]
