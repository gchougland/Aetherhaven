        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Or",
          "Sensors": [
            {
              "Type": "Target",
              "Range": {
                "Compute": "CombatBehaviorDistance"
              },
              "Filters": [
                {
                  "Type": "LineOfSight"
                }
              ]
            },
            {
              "Type": "Target",
              "TargetSlot": "LockedTarget",
              "Range": {
                "Compute": "CombatBehaviorDistance"
              },
              "Filters": [
                {
                  "Type": "LineOfSight"
                }
              ]
            }
          ]
        },
        "HeadMotion": {
          "Type": "Aim",
          "RelativeTurnSpeed": 1.5,
          "HitProbability": 1.0
        }
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Or",
          "Sensors": [
            {
              "Type": "Target",
              "Range": {
                "Compute": "AttackDistance"
              },
              "Filters": [
                {
                  "Type": "LineOfSight"
                }
              ]
            },
            {
              "Type": "Target",
              "TargetSlot": "LockedTarget",
              "Range": {
                "Compute": "AttackDistance"
