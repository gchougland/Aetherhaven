aetherhaven.dialogue.aetherhaven_tourist.main_hub.c_house=¿Te gustaría vivir aquí?
aetherhaven.dialogue.aetherhaven_tourist.main_hub.c_house_finish=Tu casa está lista.
aetherhaven.dialogue.aetherhaven_tourist.main_hub.c_house_remind=Sobre mi casa...
aetherhaven.dialogue.aetherhaven_tourist.main_hub.c_house_waiting=Sobre mudarse...
aetherhaven.dialogue.aetherhaven_tourist.main_hub.leave=Adiós

aetherhaven.dialogue.aetherhaven_tourist.tourist_house_offer.body=Me gusta tu ciudad. ¿Podrías buscarme una casa? Contribuiría diariamente al tesoro público una vez que tuviera una cama.
aetherhaven.dialogue.aetherhaven_tourist.tourist_house_offer.accept=Te encontraré un hogar.
aetherhaven.dialogue.aetherhaven_tourist.tourist_house_offer.decline=Quizás más tarde

aetherhaven.dialogue.aetherhaven_tourist.tourist_house_accepted.body=Gracias. Reserva un terreno, termina la construcción y luego pon mi nombre en el letrero de la casa. Vuelve cuando ya esté viviendo allí.
aetherhaven.dialogue.aetherhaven_tourist.tourist_house_accepted.ok=Servirá

aetherhaven.dialogue.aetherhaven_tourist.tourist_house_remind.body=¿Ya me encontraste una casa? Termina la construcción y elige mi nombre en el letrero.
aetherhaven.dialogue.aetherhaven_tourist.tourist_house_remind.ok=Bien

aetherhaven.dialogue.aetherhaven_tourist.tourist_house_waiting.body=Hay otro visitante esperando que le asignen una casa primero. Termine esa casa y luego venga a hablar conmigo.
aetherhaven.dialogue.aetherhaven_tourist.tourist_house_waiting.ok=Comprendido

aetherhaven.dialogue.aetherhaven_tourist.tourist_house_finish.body=Me siento como en casa. Gracias. Pagaré mi parte cada mañana.
aetherhaven.dialogue.aetherhaven_tourist.tourist_house_finish.ok=Bienvenido
