# Split from server.lang — keys unchanged (same lookups as before; Java uses server.<key>).
# Bundle: items, path tool, plot tokens through quest journal item





items.Aetherhaven_Lute.name=Lute
items.Aetherhaven_Lute.description=A wooden lute with warm strings. Elias Thornwood keeps one close when he plays at the guild hall.

items.Aetherhaven_Wood_Scaffold.name=Wood Scaffolding
items.Aetherhaven_Wood_Scaffold.description=Climb like a ladder. Right-click places like a normal block. Hold Use (F) while aiming at scaffolding to extend the tower from the side or branch horizontally from the top face. Breaking the bottom unsupported piece collapses the stack.
items.Aetherhaven_Wood_Scaffold.legendUse=Use (F): extend tower / branch from top while aiming at scaffold. Right-click: normal block placement.

# === Items: town, plot tokens, currency, geodes, barter, shelves, sprinklers (items.*) ===
items.Aetherhaven_Plot_Sign.name=Plot Sign
items.Aetherhaven_Plot_Sign.description=Marks where a building can be placed. Craft plot tokens at a plot crafting bench.

items.Aetherhaven_Calendar.name=Calendar
items.Aetherhaven_Calendar.description=Hang on a wall to see the season calendar and villager birthdays. Craft at the town planning desk with wood.

items.Aetherhaven_Prop_Item.name=Prop
items.Aetherhaven_Prop_Item.description=Right click to place this decoration. Use a packaging wand to pick it back up.
items.Aetherhaven_Prop_Item.instance.name=Prop: {prop}
items.Aetherhaven_Prop_Item.instance.description=Right click to place {prop}. Use a packaging wand to pick it back up.
items.Aetherhaven_Prop_Cabbage_Trough.name=Prop: Cabbage Trough
items.Aetherhaven_Prop_Cabbage_Trough.description=A trough packed with cabbages. Right click to place it.
items.Aetherhaven_Prop_Palm_Streetlight.name=Prop: Palm Streetlight
items.Aetherhaven_Prop_Palm_Streetlight.description=A leafy palm streetlight. Right click to place it.
items.Aetherhaven_Prop_Plant_Arch.name=Prop: Plant Arch
items.Aetherhaven_Prop_Plant_Arch.description=A vine covered arch. Right click to place it.
items.Aetherhaven_Prop_Pig_Pile.name=Prop: Pig Pile
items.Aetherhaven_Prop_Pig_Pile.description=A silly pile of pigs. Right click to place it.
items.Aetherhaven_Prop_Balloons.name=Prop: Balloons
items.Aetherhaven_Prop_Balloons.description=A bunch of festival balloons. Right click to place them.
items.Aetherhaven_Prop_Festival_Flag.name=Prop: Festival Flag
items.Aetherhaven_Prop_Festival_Flag.description=A bright festival flag. Right click to place it.
items.Aetherhaven_Prop_Skeleton_Coffin.name=Prop: Skeleton Coffin
items.Aetherhaven_Prop_Skeleton_Coffin.description=A spooky coffin prop. Right click to place it.
items.Aetherhaven_Prop_Spooky_Terrarium.name=Prop: Spooky Terrarium
items.Aetherhaven_Prop_Spooky_Terrarium.description=A little glass case of spooky plants. Right click to place it.
items.Aetherhaven_Prop_Zombie_Grave.name=Prop: Zombie Grave
items.Aetherhaven_Prop_Zombie_Grave.description=A crooked grave marker. Right click to place it.
items.Aetherhaven_Spooky_Candy.name=Spooky Candy
items.Aetherhaven_Spooky_Candy.description=A sweet treat from the maze and the merchant shop. Eat it to feel better.

items.Aetherhaven_Snowball.name=Snowball
items.Aetherhaven_Snowball.description=A packed snowball. Throw it for fun. It will not hurt anyone.
items.Aetherhaven_Snowball_Pile.name=Snowball Pile
items.Aetherhaven_Snowball_Pile.description=A pile of packed snow you can place. Use it at the snowball festival to take snowballs.
items.Aetherhaven_Packaging_Wand.name=Packaging Wand
items.Aetherhaven_Packaging_Wand.description=Point at a prop and use to pack it back into an item.

items.Aetherhaven_Carnival_Wheel.name=Carnival Wheel
items.Aetherhaven_Carnival_Wheel.description=A colorful wheel that hangs on a wall at the carnival.
items.Aetherhaven_Carnival_Goblin_Whacker.name=Goblin Whacker
items.Aetherhaven_Carnival_Goblin_Whacker.description=A carnival club for whacking goblins. Hits one at a time.

items.Aetherhaven_Festival_Ticket_Spring.name=Spring Festival Ticket
items.Aetherhaven_Festival_Ticket_Spring.description=A ticket for the spring festival.
items.Aetherhaven_Festival_Ticket_Summer.name=Summer Festival Ticket
items.Aetherhaven_Festival_Ticket_Summer.description=A ticket for the summer festival.

items.Aetherhaven_Festival_Firework.name=Firework
items.Aetherhaven_Festival_Firework.description=Use on the ground to send it up and watch it burst.
items.Aetherhaven_Festival_Ticket_Autumn.name=Autumn Festival Ticket
items.Aetherhaven_Festival_Ticket_Autumn.description=A ticket for the autumn festival.
items.Aetherhaven_Corin_Plushie.name=Corin Plushie
items.Aetherhaven_Corin_Plushie.description=A soft likeness of Corin from winning the Market Festival.
items.Aetherhaven_Festival_Ticket_Winter.name=Winter Festival Ticket
items.Aetherhaven_Festival_Ticket_Winter.description=A ticket for the winter festival.

items.Aetherhaven_Charter.name=Town Charter
items.Aetherhaven_Charter.description=Place to found a town. Each player may have one town per world. Use to open town info.

items.Aetherhaven_Town_Planning_Desk.name=Town Planning Desk
items.Aetherhaven_Town_Planning_Desk.description=Town planning bench. Charters, building staves, the plot crafting bench, and related recipes. Craft at a workbench.
items.Aetherhaven_Plot_Crafting_Bench.name=Plot Crafting Bench
items.Aetherhaven_Plot_Crafting_Bench.description=Craft plot tokens for buildings and decorations. Use to pick a building, preview it, and pay gold to get a token. Craft at your town planning desk.
items.Aetherhaven_Charter_Amendments_Table.name=Charter Amendments Table
items.Aetherhaven_Charter_Amendments_Table.description=Records how the town's tithe is counted and what trade the charter favors. Use to open amendments once your population supports it. Craft at your town planning desk; <color is="#ffa726">you must know the schematic</color>.
items.Aetherhaven_Banquet_Table.name=Banquet Table
items.Aetherhaven_Banquet_Table.description=A long table for town feasts. Place in your territory and use it to serve a civic feast. Craft at the town planning desk once someone in town shares the pattern.
items.Aetherhaven_Founder_Monument.name=Founder Monument
items.Aetherhaven_Founder_Monument.description=A stone pedestal that holds a likeness of the founder. Place inside town territory to honor them; the treasury's morning share grows slightly while it stands. Only one per town.
items.Aetherhaven_Inn_Bell.name=Inn Bell
items.Aetherhaven_Inn_Bell.description=Ring to call inn visitors back to the guest area.

items.Aetherhaven_Smokestack.name=Smokestack
items.Aetherhaven_Smokestack.description=Place on chimneys and rooftops for a steady wisp of smoke. Invisible when placed.

