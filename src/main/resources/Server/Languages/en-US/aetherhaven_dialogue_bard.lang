aetherhaven.dialogue.aetherhaven_bard.main_hub.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.main_hub.fallback=The strings are warm. What do you need?
aetherhaven.dialogue.aetherhaven_bard.main_hub.greeting.0=Good day. The guild hall has good acoustics today.
aetherhaven.dialogue.aetherhaven_bard.main_hub.greeting.1=Hello friend. I was just tuning my lute.
aetherhaven.dialogue.aetherhaven_bard.main_hub.greeting.2=Welcome. Music makes a town feel alive.

aetherhaven.dialogue.aetherhaven_bard.main_hub.c_play=Ask him to play a song
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_shuffle=Ask him to shuffle
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_loop=Ask him to loop a song
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_loop_current=Keep this song going
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_stop=Ask him to stop playing
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_house=Ask about a home for Elias
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_house_finish=Confirm Elias has a home
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_house_remind=Ask about the house again
aetherhaven.dialogue.aetherhaven_bard.main_hub.c_goodbye=Say goodbye

aetherhaven.dialogue.aetherhaven_bard.music_pick.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.music_pick.body=Which tune would you like?
aetherhaven.dialogue.aetherhaven_bard.music_pick.c_back=Go back
aetherhaven.dialogue.aetherhaven_bard.music_loop_pick.body=Which tune should I keep playing?

aetherhaven.dialogue.aetherhaven_bard.shuffle_started.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.shuffle_started.body=I will mix the tunes until you ask me to stop.
aetherhaven.dialogue.aetherhaven_bard.shuffle_started.c_ok=Sounds good

aetherhaven.dialogue.aetherhaven_bard.loop_started.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.loop_started.body=I will keep this one going until you ask me to stop.
aetherhaven.dialogue.aetherhaven_bard.loop_started.c_ok=Sounds good

aetherhaven.dialogue.aetherhaven_bard.music_stopped.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.music_stopped.body=All quiet again. Let me know if you want another song.
aetherhaven.dialogue.aetherhaven_bard.music_stopped.c_ok=Back to chat

aetherhaven.dialogue.aetherhaven_bard.elias_house_offer.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.elias_house_offer.body=I play here most days, but I would like a small home of my own when the sun goes down.
aetherhaven.dialogue.aetherhaven_bard.elias_house_offer.c_yes=Help him find a home
aetherhaven.dialogue.aetherhaven_bard.elias_house_offer.c_later=Not right now

aetherhaven.dialogue.aetherhaven_bard.elias_house_accepted.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.elias_house_accepted.body=Thank you. A roof that belongs to me would mean the world.
aetherhaven.dialogue.aetherhaven_bard.elias_house_accepted.c_ok=Goodbye

aetherhaven.dialogue.aetherhaven_bard.elias_house_remind.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.elias_house_remind.body=Build the house plot and assign me on the management block when it is ready.
aetherhaven.dialogue.aetherhaven_bard.elias_house_remind.c_ok=I will keep working on it

aetherhaven.dialogue.aetherhaven_bard.elias_house_finish.speaker=Elias Thornwood
aetherhaven.dialogue.aetherhaven_bard.elias_house_finish.body=My own little corner of the town. I will keep the guild hall lively for you.
aetherhaven.dialogue.aetherhaven_bard.elias_house_finish.c_ok=Wonderful

aetherhaven.dialogue.aetherhaven_bard.birthday.greeting=A birthday song day. I was hoping you would stop by.
aetherhaven.dialogue.aetherhaven_bard.gift.love.birthday=It is my birthday and this gift is wonderful. You made my whole day.
aetherhaven.dialogue.aetherhaven_bard.gift.like.birthday=A birthday gift like this. You have good taste.
aetherhaven.dialogue.aetherhaven_bard.gift.neutral.birthday=Thanks. A simple gift on my birthday still means a lot.
aetherhaven.dialogue.aetherhaven_bard.gift.dislike.birthday=It is my birthday and you brought that. Well. I still appreciate the thought.
