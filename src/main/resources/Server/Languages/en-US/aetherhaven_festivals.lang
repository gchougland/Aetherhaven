aetherhaven.festival.interactionHints.burstJackLantern=Press [{key}] to pop the jack o lantern
aetherhaven.festival.interactionHints.openMarketStall=Press [{key}] to set out goods
aetherhaven.festival.interactionHints.wintertideGift=Press [{key}] to give a Wintertide gift
aetherhaven.festival.interactionHints.takeSnowballs=Press [{key}] to take snowballs

