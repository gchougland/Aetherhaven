# Festivals: festival names, town announcements, and the festival admin command (en-US source).

aetherhaven.festival.new_life.name=New Life Festival
aetherhaven.festival.new_life.description=Spring begins. The town gathers around the Springheart Lettuce and feeds it life essence until it is ready to pop with seeds and spring festival tickets.

aetherhaven.festival.pig_race.name=Pig Racing Festival
aetherhaven.festival.pig_race.description=Late spring brings the pig races. Bet gold coins on a pig, cheer it down the track, and spend spring festival tickets at the race merchant.

aetherhaven.festival.carnival.name=Carnival Festival
aetherhaven.festival.carnival.description=Late summer brings the carnival. Pop balloons, spin the wheel, and spend summer festival tickets at the carnival merchant.

aetherhaven.festival.interactionHints.burstLettuce=Press [{key}] to pop the lettuce

