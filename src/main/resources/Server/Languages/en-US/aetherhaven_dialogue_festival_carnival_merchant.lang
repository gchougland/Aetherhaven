# Carnival festival merchant dialogue

aetherhaven.dialogue.festival_carnival_merchant.speaker=Carnival Merchant
aetherhaven.dialogue.festival_carnival_merchant.main_hub.body=Welcome to the carnival! I take summer festival tickets for prizes. Have a look around the games too.
aetherhaven.dialogue.festival_carnival_merchant.main_hub.c_shop=Show me your goods.
aetherhaven.dialogue.festival_carnival_merchant.main_hub.c_about=What do you sell?
aetherhaven.dialogue.festival_carnival_merchant.main_hub.c_goodbye=Maybe later.

aetherhaven.dialogue.festival_carnival_merchant.about.body=Right now I have a soft kweebec plushie for two summer festival tickets. Win tickets at the balloon booth or the spinning wheel, then come spend them here.
aetherhaven.dialogue.festival_carnival_merchant.about.c_back=Sounds fun.
