items.Aetherhaven_Plot_Token_Inn.name=Gasthaus-Grundstücksmarke
items.Aetherhaven_Plot_Token_Inn.description=Erforderlich im Inventar, um das Platzierungspersonal für den Gasthofgrundriss zu verwenden.

items.Aetherhaven_Plot_Token_Market_Stall.name=Marktstand-Grundstücksmarke
items.Aetherhaven_Plot_Token_Market_Stall.description=Die Mitarbeiter der Grundstückszuweisung müssen die Grundfläche des Marktstandes festlegen.
items.Aetherhaven_Plot_Token_Player_Shop.name=Spielerladen-Grundstücksmarke
items.Aetherhaven_Plot_Token_Player_Shop.description=Erforderlich, um den Grundriss des Spielerladens vom Grundstücksplatzierungspersonal zu platzieren.

items.Aetherhaven_Plot_Token_Farm.name=Farmparzellen-Token
items.Aetherhaven_Plot_Token_Farm.description=Erforderlich ist die Platzierung des Grundrisses der landwirtschaftlichen Parzelle durch das Parzellenzuweisungspersonal.

items.Aetherhaven_Plot_Token.name=Plot-Token
items.Aetherhaven_Plot_Token.description=Platziert ein benutzerdefiniertes Stadtgebäude aus dem Plotplatzierungsteam. Jeder Token ist einem Gebäudetyp zugeordnet.
items.Aetherhaven_Plot_Token.instance.name={building} Plot-Token
items.Aetherhaven_Plot_Token.instance.description=Erforderlich ist die Platzierung des {building}-Fußabdrucks durch das Personal für die Grundstücksplatzierung.

items.Aetherhaven_Plot_Token_Unlock_Page.name=Plotplan
items.Aetherhaven_Plot_Token_Unlock_Page.description=Eine spezielle Bauplanseite. Nutze sie, um an deiner Bauplanwerkbank ein neues Grundstück zu erstellen.
items.Aetherhaven_Plot_Token_Unlock_Page.instance.name=Plot-Vorlage: {building}
items.Aetherhaven_Plot_Token_Unlock_Page.instance.description=Lesen Sie dies, um das Grundstück {building} an Ihrer Grundstückswerkbank dauerhaft freizuschalten.

items.Aetherhaven_Plot_Creator_Staff.name=Mitarbeiter der Handlungserstellung
items.Aetherhaven_Plot_Creator_Staff.description=Verwandle ein Gebäude in ein individuelles Stadtgebäude. Siehe die Anleitung im Stadtjournal. F startet den aktuellen Schritt oder führt eine Aktion aus. Klicke mit der rechten Maustaste, um Bereiche und Positionen festzulegen. Q/E: vorheriger/nächster Schritt. R: Abbruch.

items.Aetherhaven_Plot_Token_Blacksmith_Shop.name=Schmiedeladen-Grundstücksmarke
items.Aetherhaven_Plot_Token_Blacksmith_Shop.description=Erforderlich, um den Grundriss der Schmiede anhand der Vorgaben des Grundstücksplatzierungspersonals zu platzieren.

items.Aetherhaven_Plot_Token_Park.name=Parkplatz-Token
items.Aetherhaven_Plot_Token_Park.description=Die Zuweisung des Parkgrundrisses durch das Parzellenzuweisungspersonal ist erforderlich.
items.Aetherhaven_Plot_Token_Tourist_Portal.name=Touristenportal-Grundstücksmarke
items.Aetherhaven_Plot_Token_Tourist_Portal.description=Erforderlich, um den Fußabdruck des Touristenportals vom Grundstückszuweisungspersonal zu platzieren.

items.Aetherhaven_Plot_Token_House.name=Hausgrundstücksmarke
items.Aetherhaven_Plot_Token_House.description=Die Mitarbeiter der Grundstückszuweisung müssen den Grundriss des gemeinsamen Hauses festlegen.

items.Aetherhaven_Plot_Token_Town_Hall.name=Grundstücksmarke für das Rathaus
items.Aetherhaven_Plot_Token_Town_Hall.description=Erforderlich, um den Grundriss des Rathauses anhand der Vorgaben des Grundstückszuweisungspersonals zu platzieren.

items.Aetherhaven_Plot_Token_Guild_Hall.name=Gildenhallen-Grundstücksmarke
items.Aetherhaven_Plot_Token_Guild_Hall.description=Markiert die Stellen, an denen das Fertiggebäude der Gildenhalle errichtet werden kann. Hergestellt am Stadtplanungsschalter.

items.Aetherhaven_Gold_Coin.name=Goldmünze
items.Aetherhaven_Gold_Coin.description=Die Stadtwährung wird in der Schatzkammer aufbewahrt.

items.Aetherhaven_Geode.name=Geode
items.Aetherhaven_Geode.description=Ein hohler Stein, der Kristalle, Edelsteine oder Erz enthalten kann. Bezahle einen Schmied, der ihn aufbricht.


items.Aetherhaven_Crystallized_Person.name=Kristallisierte Person

items.Aetherhaven_Treasury.name=Stadtkasse
items.Aetherhaven_Treasury.description=Hier werden die Goldmünzen der Stadt aufbewahrt. Dient zum Einzahlen oder Abheben (für den Stadtbesitzer).
items.Aetherhaven_Shop_Safe.name=Sicher einkaufen
items.Aetherhaven_Shop_Safe.description=Hier wird Gold aus deinen Verkäufen im Spielershop gespeichert. Nutze es, um deine Einnahmen abzuholen.

items.Aetherhaven_Quest_Journal.name=Stadtjournal
items.Aetherhaven_Quest_Journal.description=Zweiter Verwendungszweck: Öffne dein Stadtjournal. Hier kannst du nach Quests suchen.
