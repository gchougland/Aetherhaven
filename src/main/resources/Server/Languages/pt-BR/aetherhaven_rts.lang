aetherhaven.rts.hudTitle=Comando da Guarda
aetherhaven.rts.rosterTitle=Guardas da cidade
aetherhaven.rts.orderAttackMove=Ordem: Movimento de ataque
aetherhaven.rts.orderMove=Ordem: Mover
aetherhaven.rts.orderFocusAttack=Ordem: Fogo concentrado
aetherhaven.rts.stanceDefensive=Postura: Defensiva
aetherhaven.rts.stanceAggressive=Postura: Agressiva
