$C = "../Common.ui";
$T = "TownUiTheme.ui";
Group { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 10); Padding: (Full: 12); Background: $T.@Card;
 Group { LayoutMode: Left; Anchor: (Height: 64, Bottom: 6);
  ItemIcon #Icon { TextTooltipStyle: $C.@DefaultTextTooltipStyle; Anchor: (Width: 60, Height: 60, Right: 8); }
  Label #Name { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #e0d3af, Wrap: true, RenderBold: true, VerticalAlignment: Center); }
 }
 Label #Source { Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8fa99f); }
 Label #Effect { Anchor: (Height: 48, Bottom: 6); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7cbbb, Wrap: true); }
 $C.@SecondaryTextButton #Equip { Text: "Equip"; Anchor: (Height: 30); }
}
