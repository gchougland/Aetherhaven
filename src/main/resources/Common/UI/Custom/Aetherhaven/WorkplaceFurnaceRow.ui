$C = "../Common.ui";
$T = "TownUiTheme.ui";
Group { LayoutMode: Left; Anchor: (Height: 60, Bottom: 4); Background: $T.@Card; Padding: (Horizontal: 8);
  Label #Name { Anchor: (Width: 200, Right: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, VerticalAlignment: Center); }
  Label { Text: "IN"; Anchor: (Width: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 12, VerticalAlignment: Center, TextColor: #becadb); }
  Group #In { LayoutMode: Left; Anchor: (Width: 240, Right: 12); }
  Label { Text: "OUT"; Anchor: (Width: 38); Style: (...$C.@DefaultLabelStyle, FontSize: 12, VerticalAlignment: Center, TextColor: #becadb); }
  Group #Out { LayoutMode: Left; FlexWeight: 1; }
}
