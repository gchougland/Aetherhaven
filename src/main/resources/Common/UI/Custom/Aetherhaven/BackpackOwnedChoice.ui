$C = "../Common.ui";
$T = "TownUiTheme.ui";
Group { Anchor: (Height: 110, Bottom: 8);
 Button #Button { Anchor: (Full: 0); Padding: (Full: 12); LayoutMode: Left; TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  Style: (Default: (Background: $T.@Slot), Hovered: (Background: $T.@CardHovered), Pressed: (Background: $T.@CardPressed), Disabled: (Background: $T.@Inset));
  ItemIcon #Icon { Anchor: (Width: 42, Height: 42, Right: 8); }
  Group { FlexWeight: 1; LayoutMode: Top;
   Label #Name { Anchor: (Height: 48); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #e8c984, Wrap: true); }
   Label #Detail { Anchor: (Height: 30); Style: (...$C.@DefaultLabelStyle, FontSize: 11, Wrap: true); }
  }
 }
}
