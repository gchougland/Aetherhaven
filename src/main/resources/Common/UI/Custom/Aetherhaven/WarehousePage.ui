$C = "../Common.ui";
$T = "TownUiTheme.ui";
@Control = TextButtonStyle(
  Default: (Background: $C.@TertiaryDefaultButtonBackground, LabelStyle: (FontSize: 13, TextColor: #d4e0dd, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: $C.@TertiaryHoveredButtonBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: $C.@TertiaryPressedButtonBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Disabled: (Background: $C.@TertiaryDisabledButtonBackground, LabelStyle: (FontSize: 13, TextColor: #82b79e, HorizontalAlignment: Center, VerticalAlignment: Center))
);
@TabControl = TextButtonStyle(
  Default: (Background: $C.@TertiaryDefaultButtonBackground, LabelStyle: (FontSize: 13, TextColor: #d4e0dd, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: $C.@TertiaryHoveredButtonBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: $C.@TertiaryPressedButtonBackground, LabelStyle: (FontSize: 13, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Disabled: (Background: $C.@TertiaryActiveButtonBackground, LabelStyle: (FontSize: 13, TextColor: #82b79e, HorizontalAlignment: Center, VerticalAlignment: Center))
);
$C.@PageOverlay { LayoutMode: Middle;
  $C.@DecoratedContainer { Anchor: (Width: 1120, Height: 790);
    #Title { Label #TitleText { Text: "TOWN WAREHOUSE"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
    #Content { LayoutMode: Top; Padding: (Full: 22);
      Group { LayoutMode: Left; Anchor: (Height: 64, Bottom: 16);
        Group { LayoutMode: Top; FlexWeight: 1;
          Label #TownName { Anchor: (Height: 30); Style: (...$C.@DefaultLabelStyle, FontSize: 22, TextColor: #e1c992, RenderBold: true); }
          Label { Text: "One ledger. Every store in town."; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9db6ae); }
        }
        Group #CapacityPanel { LayoutMode: Top; Anchor: (Width: 230); Padding: (Full: 10); Background: $T.@Panel;
          Label #Capacity { Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b6d0c6, HorizontalAlignment: End); }
          Group { Anchor: (Height: 5, Top: 8); Background: #0f1e28;
            Group #CapacityFill { Anchor: (Left: 0, Top: 0, Width: 0, Height: 5); Background: #8cc4a5; }
          }
        }
      }
      Group { LayoutMode: Left; FlexWeight: 1;
        Group { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 18);
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 12);
            TextButton #GENERAL { Text: "GENERAL STORAGE"; Style: @TabControl; FlexWeight: 1; Anchor: (Right: 6); }
            TextButton #OUTPUT { Text: "CRAFTED GOODS"; Style: @TabControl; FlexWeight: 1; Anchor: (Right: 6); }
            TextButton #PRODUCTION { Text: "BUILDING OUTPUTS"; Style: @TabControl; FlexWeight: 1; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 36, Bottom: 12);
            $C.@TextField #Search { PlaceholderText: "Find an item"; FlexWeight: 1; Anchor: (Right: 6); }
            TextButton #SearchButton { Text: "Find"; Style: @Control; Anchor: (Width: 50, Right: 6); }
            TextButton #Sort { Text: "Sort: name"; Style: @Control; Anchor: (Width: 115, Right: 6); }
            TextButton #View { Text: "List view"; Style: @Control; Anchor: (Width: 88); }
          }
          Label #Description { Anchor: (Height: 42, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9cb1b8, Wrap: true); }
          Group { FlexWeight: 1; Background: $T.@Panel; Padding: (Full: 10);
            Group #Grid { LayoutMode: Top; Anchor: (Full: 0); }
            Group #List { LayoutMode: Top; Anchor: (Full: 0); Visible: false; }
            Group #Production { LayoutMode: TopScrolling; Anchor: (Full: 0); ScrollbarStyle: $C.@DefaultScrollbarStyle; Visible: false; }
            Group #Empty { LayoutMode: Middle; Anchor: (Full: 0);
              Group { LayoutMode: Top; Anchor: (Width: 380, Height: 88);
                Label #EmptyTitle { Text: "Room for your town to grow"; Anchor: (Height: 30); Style: (...$C.@DefaultLabelStyle, FontSize: 18, TextColor: #c7b889, HorizontalAlignment: Center); }
                Label #EmptyHelp { Text: "Click something in your inventory to store it here."; Anchor: (Height: 52); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #92abae, HorizontalAlignment: Center, Wrap: true); }
              }
            }
          }
          Group { LayoutMode: Left; Anchor: (Height: 34, Top: 10);
            TextButton #Previous { Text: "Previous"; Style: @Control; Anchor: (Width: 85); }
            Label #Page { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #98b1ac, HorizontalAlignment: Center, VerticalAlignment: Center); }
            TextButton #Next { Text: "Next"; Style: @Control; Anchor: (Width: 85, Right: 8); }
            TextButton #Refresh { Text: "Refresh"; Style: @Control; Anchor: (Width: 85); }
          }
        }
        Group { LayoutMode: Top; Anchor: (Width: 324); Background: $T.@Panel; Padding: (Full: 12);
          Label { Text: "YOUR INVENTORY"; Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #d9c48f, RenderBold: true); }
          Label #InventoryHint { Text: "Click to deposit into General storage."; Anchor: (Height: 42, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #98b6ac, Wrap: true); }
          Group { LayoutMode: TopScrolling; FlexWeight: 1; ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Group #PlayerItems { LayoutMode: LeftCenterWrap; }
          }
          Label { Text: "Left click: a stack"; Anchor: (Height: 22, Top: 10); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a8bfbd); }
          Label { Text: "Right click: one item"; Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a8bfbd); }
        }
      }
      Group { LayoutMode: Left; Anchor: (Height: 40, Top: 16);
        Label #Hint { FlexWeight: 1; Anchor: (Right: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b9cbbf, Wrap: true); }
        TextButton #Upgrade { Text: "Expand storage"; Style: @Control; Anchor: (Width: 360); }
      }
    }
  }
}
$C.@BackButton {}
