$C = "../Common.ui";
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer { Anchor: (Width: 1080, Height: 820);
  #Title { Label #ScreenTitle { Text: "RANCHER'S ANIMAL SHOP"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
  #Content { LayoutMode: Top; Padding: (Full: 20);
   Label #Summary { Anchor: (Height: 26, Bottom: 12); Style: (...$C.@DefaultLabelStyle, TextColor: #dec68d); }
   Label #Instructions { Text: "Owned animals keep their names and hearts while resting. Choose active pens at the barn."; Anchor: (Height: 42, Bottom: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true, TextColor: #b7c9bb); }
   Group #Rows { Anchor: (Height: 476); }
   Label #EmptyList { Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle); Visible: false; }
   Group { LayoutMode: Left; Anchor: (Height: 34, Top: 12, Bottom: 12);
    Label #Page { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, TextColor: #b7c9bb); }
    $C.@SmallSecondaryTextButton #Previous { Text: "Previous"; Anchor: (Width: 100, Right: 8); }
    $C.@SmallSecondaryTextButton #Next { Text: "Next"; Anchor: (Width: 80, Right: 8); }
    $C.@SmallSecondaryTextButton #Refresh { Text: "Refresh"; Anchor: (Width: 100); }
    $C.@SmallSecondaryTextButton #Return { Text: "Back to barn"; Anchor: (Width: 145, Left: 8); Visible: false; }
   }
   Label #FooterStatus { Anchor: (Height: 42); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #dec68d); }
  }
 }
}
$C.@BackButton {}
