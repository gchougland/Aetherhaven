$C = "../Common.ui";
$T = "TownUiTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer { Anchor: (Width: 750, Height: 700);
  #Title { Label { Text: "UPDATE THIS MINE"; Style: (...$C.@TitleStyle); } }
  #Content { LayoutMode: Top; Padding: (Full: 24);
   Group { LayoutMode: Left; Anchor: (Height: 84, Bottom: 12); Background: $T.@Panel; Padding: (Full: 12);
    ItemIcon { ItemId: "Ore_Copper_Stone"; Anchor: (Width: 60, Height: 60, Right: 18); }
    Group { LayoutMode: Top; FlexWeight: 1;
     Label { Text: "LEGACY MINE   >   MINING NODES"; Anchor: (Height: 30); Style: (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 18); }
     Label #NodeCount { Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, TextColor: #dec68d); }
    }
   }
   Label { Text: "NODE PLAN   |   NORTH AT TOP"; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7c9bb); }
   Group #Map { Anchor: (Height: 216, Bottom: 8); Background: $T.@Inset; }
   Group { LayoutMode: Left; Anchor: (Height: 44);
    $C.@SecondaryTextButton #Previous { Text: "<"; Anchor: (Width: 38, Height: 32, Right: 8); }
    Label #Details { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true); }
    $C.@SecondaryTextButton #Next { Text: ">"; Anchor: (Width: 38, Height: 32, Left: 8); }
   }
   Label #Status { Anchor: (Height: 58); Style: (...$C.@DefaultLabelStyle, TextColor: #dec68d, Wrap: true, FontSize: 15); }
   Group { LayoutMode: Left; Anchor: (Height: 36, Bottom: 10);
    $C.@SecondaryTextButton #Edit { Text: "Choose cells in this mine"; FlexWeight: 1; Anchor: (Right: 10); }
    $C.@SecondaryTextButton #Discard { Text: "Discard selection"; Anchor: (Width: 180); Visible: false; }
   }
   Label { Text: "Only the reviewed node locations change when the Miner starts work. The rest of your building stays as it is."; Anchor: (Height: 42, Bottom: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7c9bb, Wrap: true); }
   Group { LayoutMode: Left; Anchor: (Height: 40);
    $C.@SecondaryTextButton #Catalog { Text: "Building catalog"; Anchor: (Width: 180, Right: 8); }
    $C.@SecondaryTextButton #Preview { Text: "Show in world"; Anchor: (Width: 180, Right: 8); }
    $C.@TextButton #Apply { Text: "Apply node layout"; FlexWeight: 1; }
   }
  }
 }
}
$C.@BackButton {}
