$C = "../Common.ui";
$C.@PageOverlay {
  LayoutMode: Middle;
  $C.@DecoratedContainer {
    Anchor: (Width: 1120, Height: 830);
    #Title { Label #TitleText { Text: "WORKPLACE TASKS"; Anchor: (Width: 1000); Style: (...$C.@TitleStyle, FontSize: 20, HorizontalAlignment: Center); } }
    #Content {
      LayoutMode: Top; Padding: (Full: 18);
      Group { LayoutMode: Left; Anchor: (Height: 38, Bottom: 5);
        Label #MainBench { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #e0c891, VerticalAlignment: Center); }
        $C.@SecondaryTextButton #Station { Text: "Station upgrades"; Anchor: (Width: 190, Left: 10); Visible: false; }
      }
      Label #Equipment { Anchor: (Height: 42, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #a5cabc, Wrap: true); }
      Group #FuelRow { LayoutMode: Left; Anchor: (Height: 38, Bottom: 8); Visible: false;
        $C.@SecondaryTextButton #Fuel { Text: "Fuel: wood"; Anchor: (Width: 210, Right: 12); }
        Label { Text: "Charcoal batches use wood. Other tasks use the chosen fuel."; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13, VerticalAlignment: Center); }
      }
      Group #Furnaces { LayoutMode: Top; Visible: false; }
      Group { LayoutMode: Left; FlexWeight: 1;
        Group { LayoutMode: Top; Anchor: (Width: 500, Right: 18);
          Label #CatalogHeading { Text: "RECIPES"; Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 16); }
          Group #RecipeSearch { LayoutMode: Left; Anchor: (Height: 38, Bottom: 10);
            $C.@TextField #Search { FlexWeight: 1; PlaceholderText: "Search recipes"; Anchor: (Right: 8); }
            $C.@SecondaryTextButton #SearchButton { Padding: (Horizontal: 8); Text: "Search"; Anchor: (Width: 85); }
          }
          Group #RecipeList { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; FlexWeight: 1; Group #Recipes { LayoutMode: Top; } }
          Group #RecipePaging { LayoutMode: Left; Anchor: (Height: 32, Top: 6);
            $C.@SecondaryTextButton #RecipePrevious { Padding: (Horizontal: 8); Text: "Previous"; Anchor: (Width: 102); }
            Label #RecipePage { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, HorizontalAlignment: Center, VerticalAlignment: Center); }
            $C.@SecondaryTextButton #RecipeNext { Padding: (Horizontal: 8); Text: "Next"; Anchor: (Width: 102); }
          }
          Group #JewelryDesigner { LayoutMode: Top; FlexWeight: 1; Visible: false; }
          Group #AlchemyDesigner { LayoutMode: Top; FlexWeight: 1; Visible: false; }
          Group #ArmoryDesigner { LayoutMode: Top; FlexWeight: 1; Visible: false; }
          Group #CultivationDesigner { LayoutMode: Top; FlexWeight: 1; Visible: false;
            Group #CropFamilies { LayoutMode: Top; }
            Label #Beds { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, Wrap: true, TextColor: #a5cabc); }
          }
          $C.@SecondaryTextButton #CultivationBrowse { Text: "Browse all crops"; Anchor: (Height: 32, Top: 8); Visible: false; }
          $C.@SecondaryTextButton #AlchemyBrowse { Text: "Browse all recipes"; Anchor: (Height: 32, Top: 8); Visible: false; }
          $C.@SecondaryTextButton #ArmoryBrowse { Text: "Browse all recipes"; Anchor: (Height: 32, Top: 8); Visible: false; }
          $C.@SecondaryTextButton #JewelryBrowse { Text: "Browse all plans"; Anchor: (Height: 32, Top: 8); Visible: false; }
        }
        Group { LayoutMode: Top; FlexWeight: 1;
          Label { Text: "TASK ORDER"; Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 16); }
          Label { Text: "Higher tasks have priority. Paused tasks stay in the list."; Anchor: (Height: 35); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true); }
          Group { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; FlexWeight: 1; Group #Orders { LayoutMode: Top; } }
        }
      }
      Label #Selected { Anchor: (Height: 32, Top: 10); Style: (...$C.@DefaultLabelStyle); }
      Label #Details { Anchor: (Height: 25); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #becadb); }
      Group { LayoutMode: Left; Anchor: (Height: 124, Bottom: 10);
        Group { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 18);
          Label { Text: "MATERIALS PER BATCH"; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 12); }
          Group { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; FlexWeight: 1; Group #Inputs { LayoutMode: Top; } }
        }
        Group { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 18);
          Label { Text: "OUTPUT PER BATCH"; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 12); }
          Group { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; FlexWeight: 1; Group #Outputs { LayoutMode: Top; } }
        }
        Group { LayoutMode: Top; Anchor: (Width: 372);
          Label #StoredTitle { Text: "FINISHED GOODS IN STORE"; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 12); }
          Label #StoredEmpty { Text: "Nothing from this workplace's tasks is waiting. Click a stack to collect it."; Anchor: (Height: 40); Style: (...$C.@DefaultLabelStyle, FontSize: 12, Wrap: true, TextColor: #becadb); }
          Group { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; FlexWeight: 1; Group #Stored { LayoutMode: LeftCenterWrap; } }
        }
      }
      Group { LayoutMode: Left; Anchor: (Height: 40, Bottom: 8);
        $C.@SecondaryTextButton #Mode { Padding: (Horizontal: 8); Text: "Craft amount"; Anchor: (Width: 240, Right: 10); }
        $C.@TextField #OrderQuantity { Anchor: (Width: 90, Right: 10); Value: "1"; }
        $C.@TextButton #Add { Text: "Add task"; FlexWeight: 1; Anchor: (Right: 10); }
        $C.@SecondaryTextButton #Refresh { Padding: (Horizontal: 8); Text: "Refresh"; Anchor: (Width: 105, Right: 10); }
        $C.@SecondaryTextButton #Back { Padding: (Horizontal: 8); Text: "Back"; Anchor: (Width: 100); }
      }
      Label #Hint { Anchor: (Height: 38); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #dec68d); }
    }
  }
}
$C.@BackButton {}

