$C = "../Common.ui";
$C.@PageOverlay {
  LayoutMode: Middle;
  $C.@DecoratedContainer {
    Anchor: (Width: 780, Height: 750);
    #Title { Label { Text: "WORKPLACE"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
    #Content {
      LayoutMode: Top; Padding: (Full: 20);
      $C.@TextField #Name { Anchor: (Height: 40, Bottom: 10); PlaceholderText: "Workplace name"; }
      Label #Area { Anchor: (Height: 30, Bottom: 8); Style: (...$C.@DefaultLabelStyle, TextColor: #a5cabc); }
      Label #MainBench { Anchor: (Height: 36, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 15, Wrap: true, TextColor: #e0c891); }
      Group { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; FlexWeight: 1;
        Label #NoTypes { Text: "No workplace types are unlocked yet. Speak to a supervising villager to unlock one."; Anchor: (Height: 64); Style: (...$C.@DefaultLabelStyle, FontSize: 15, Wrap: true, TextColor: #becadb); Visible: false; }
        Group #Types { LayoutMode: Top; }
      }
      Label #Hint { Anchor: (Height: 60, Top: 12); Style: (...$C.@DefaultLabelStyle, Wrap: true, FontSize: 14, TextColor: #becadb); }
      $C.@SecondaryTextButton #Tasks { Text: "Tasks for saved workplace"; Anchor: (Height: 38, Bottom: 10); Visible: false; }
      Group { LayoutMode: Left; Anchor: (Height: 44);
        $C.@SecondaryTextButton #Remove { Text: "Remove workplace"; Visible: false; Padding: (Horizontal: 10); Anchor: (Width: 210, Right: 10); }
        $C.@TextButton #Save { Text: "Save workplace"; FlexWeight: 1; Padding: (Horizontal: 10); Anchor: (Right: 10); }
        $C.@SecondaryTextButton #Cancel { Text: "Cancel"; Anchor: (Width: 150); }
      }
    }
  }
}
$C.@BackButton {}
