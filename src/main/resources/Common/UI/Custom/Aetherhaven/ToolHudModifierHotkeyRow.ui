// A tool hint row for an action used while crouching: "Crouch +", the action name, then what it does.
// The game has no key prompt for a chord, so both parts are action names and neither is a key.
// #ModifierLabel holds the name of the held action, #KeyLabel the name of the action used with it.

Group #ControlRow {
  LayoutMode: Left;
  Anchor: (Vertical: 3);

  Group #ActionWrap {
    LayoutMode: LeftWrap;
    Anchor: (Width: 152, Right: 10);

    Label #ModifierLabel {
      Anchor: (Right: 4);
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: #b9c6d6
      );
      Text: "";
    }

    Label #KeyLabel {
      Style: (
        FontSize: 14,
        RenderBold: true,
        TextColor: #e6edf5
      );
      Text: "";
    }
  }

  Group #DescWrap {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #DescLabel {
      Style: (
        FontSize: 14,
        TextColor: #96a9be,
        Wrap: true
      );
      Text: "";
    }
  }
}
