$C = "../Common.ui";
$T = "TownUiTheme.ui";
Group { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 6); Padding: (Full: 12); Background: $T.@Panel;
 Label #Family { Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 15, RenderBold: true, HorizontalAlignment: Center, TextColor: #dec68d); }
 Group { LayoutMode: Center; Anchor: (Height: 54, Bottom: 4); ItemIcon #Icon { Anchor: (Width: 48, Height: 48); } }
 Label #Pair { Anchor: (Height: 34); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, HorizontalAlignment: Center, TextColor: #b7c9bb); }
 Label #Stage { Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 10, RenderBold: true, HorizontalAlignment: Center); }
 Group #Progress { LayoutMode: Full; Anchor: (Height: 20, Bottom: 6);
  Group { LayoutMode: Left; Anchor: (Left: 5, Right: 5, Top: 4, Bottom: 4); Background: #121820;
   Group #Fill { FlexWeight: 1; Background: (TexturePath: "../XpBar.png", Border: 0, Color: #8ad3bb); }
   Group #Remainder { FlexWeight: 999; }
  }
  Group { Anchor: (Full: 0); Background: (TexturePath: "../XpBarBorder.png", Border: 8); }
 }
 Label #Activity { Anchor: (Height: 50); Style: (...$C.@DefaultLabelStyle, FontSize: 12, Wrap: true, HorizontalAlignment: Center); }
}
