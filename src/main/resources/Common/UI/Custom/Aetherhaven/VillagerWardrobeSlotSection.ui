$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@IconLbl = (
  FontSize: 6,
  TextColor: #ffffff(0.01),
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@WardrobeArrowBackStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);

@WardrobeArrowForwardStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);

Group #WardrobeSlotSection {
  LayoutMode: Top;
  Anchor: (Bottom: 12);
  Padding: (Full: 8);
  Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);

  Label #SlotTitle {
    Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #e8dcc8);
    Anchor: (Bottom: 8);
  }

  Group #PickerRow {
    LayoutMode: Left;

    TextButton #PrevCosmetic {
      Style: @WardrobeArrowBackStyle;
      Anchor: (Width: 36, Height: 36, Right: 8);
      Padding: (Full: 0);
      Text: ".";
    }

    Label #CosmeticName {
      Style: (...$C.@DefaultLabelStyle, TextColor: #e8dcc8, Wrap: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      FlexWeight: 1;
      Anchor: (Height: 36, Right: 8);
      Text: "";
    }

    TextButton #NextCosmetic {
      Style: @WardrobeArrowForwardStyle;
      Anchor: (Width: 36, Height: 36);
      Padding: (Full: 0);
      Text: ".";
    }
  }
}
