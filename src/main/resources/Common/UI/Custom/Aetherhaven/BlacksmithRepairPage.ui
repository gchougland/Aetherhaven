$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 640, Height: 420);

  #Title {
    Group {
      Label #TitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Text: "";
      }
    }
  }

  #Content {
    // "Price depends on wear. An item costs up to [gold]" then the how-to on its own line.
    Group #HintLine {
      LayoutMode: Left;
      Anchor: (Bottom: 2);

      Label #HintText {
        Style: (...$C.@DefaultLabelStyle, TextColor: #ffffff(0.7), VerticalAlignment: Center);
        Anchor: (Right: 4);
        Text: "";
      }

      Group #MaxCost {
        LayoutMode: Middle;
        Anchor: (Vertical: 0);
      }
    }

    Label #Hint {
      Anchor: (Bottom: 8);
      Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #ffffff(0.7));
      Text: "";
    }

    Group {
      LayoutMode: Left;
      Padding: (Right: 15, Bottom: 5);

      Label #ItemHeader {
        FlexWeight: 1;
        Style: (RenderBold: true);
        Text: "";
      }

      Label #CostHeader {
        Anchor: (Width: 130);
        Padding: (Horizontal: 10);
        Style: (RenderBold: true, HorizontalAlignment: End);
        Text: "";
      }

      Label #DurabilityHeader {
        Anchor: (Width: 100);
        Padding: (Horizontal: 10);
        Style: (RenderBold: true, HorizontalAlignment: End);
        Text: "";
      }
    }

    Group #ElementList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }
  }
}

$C.@BackButton {}
