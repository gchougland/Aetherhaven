$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@QtyStyle = (...$C.@DefaultLabelStyle, TextColor: #c8d4e8, HorizontalAlignment: Center);
@TimeStyle = (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8fa0b0, HorizontalAlignment: Center);
@NameStyle = (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #e8dcc8, HorizontalAlignment: Center);

@PickBtnStyle = (
  Default: (Background: #000000(0)),
  Hovered: (Background: #ffffff(0.06)),
  Pressed: (Background: #ffffff(0.10)),
  Disabled: (Background: #000000(0))
);

@NarrowProductionProg = ProgressBar {
  Anchor: (Width: 88, Height: 5);
  Background: "../Common/ProgressBar.png";
  BarTexturePath: "../Common/ProgressBarFill.png";
  EffectTexturePath: "../Common/ProgressBarEffect.png";
  EffectWidth: 102;
  EffectHeight: 58;
  EffectOffset: 74;
  Value: 0.0;
};

Group #ProductionStorageSlot {
  LayoutMode: Top;
  Anchor: (Width: 180, Height: 370);
  Padding: (Full: 6);
  Background: #1a2932;

  Group #Unlocked { LayoutMode: Top;

  Group {
    LayoutMode: Center;
    Anchor: (Bottom: 8);

    Button #Pick {
      LayoutMode: Top;
      Style: @PickBtnStyle;
      TextTooltipStyle: $C.@DefaultTextTooltipStyle;
      Anchor: (Width: 56, Height: 56);

      Group #IconBox {
        LayoutMode: Full;
        Background: #1a2530;
        Padding: 2;
        Anchor: (Width: 52, Height: 52);
        HitTestVisible: false;

        Group #IconSlot {
          LayoutMode: Full;
          HitTestVisible: false;

          /** AssetImage (not ItemGrid) so clicks reach {@code #Pick} across the full icon. */
          AssetImage #Icon {
            Anchor: (Full: 0);
            FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
            HitTestVisible: false;
          }
          Group #RequirementLock { Anchor: (Full: 0); Background: #2b3038(0.84); Visible: false; HitTestVisible: false;
            AssetImage { AssetPath: "UI/Custom/padlock.png"; Anchor: (Width: 28, Height: 28, Left: 10, Top: 10); HitTestVisible: false; }
          }
        }
      }
    }
  }

  Label #Name {
    Style: (...@NameStyle);
    Anchor: (Bottom: 6, Width: 168, Height: 44);
    Text: "";
  }

  Label #Qty {
    Style: (...@QtyStyle);
    Anchor: (Bottom: 4, Width: 168, Height: 24);
    Text: "";
  }

  Group {
    LayoutMode: Center;
    Anchor: (Bottom: 6, Width: 168);
    @NarrowProductionProg #Prog {}
  }

  Label #Time {
    Style: (...@TimeStyle, Wrap: true);
    Anchor: (Bottom: 8, Width: 168, Height: 42);
    Text: "";
  }

  Group {
    LayoutMode: Top;
    Anchor: (Width: 168);
    Group {
      LayoutMode: Center;
      Anchor: (Bottom: 4);
      $C.@TextButton #Take1 {
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Anchor: (Width: 160, Height: 32, Bottom: 4);
        Text: "";
      }
    }
    Group {
      LayoutMode: Center;
      Anchor: (Bottom: 4);
      $C.@TextButton #Take10 {
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Anchor: (Width: 160, Height: 32, Bottom: 4);
        Text: "";
      }
    }
    Group {
      LayoutMode: Center;
      $C.@TextButton #Take100 {
        TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        Anchor: (Width: 160, Height: 32);
        Text: "";
      }
    }
  }
  }
  Group #Locked { LayoutMode: Top; Visible: false; Anchor: (Width: 168, Height: 358); Padding: (Horizontal: 8, Top: 42);
    Group { LayoutMode: Middle; Anchor: (Height: 84, Bottom: 16);
      Group { Anchor: (Width: 64, Height: 64); Background: #343b43;
        AssetImage { AssetPath: "UI/Custom/padlock.png"; Anchor: (Width: 40, Height: 40, Top: 12, Left: 12); }
      }
    }
    Label #LockedTitle { Anchor: (Height: 30, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, HorizontalAlignment: Center, TextColor: #adb6bf); }
    Label { Text: "LOCKED"; Anchor: (Height: 24, Bottom: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 11, HorizontalAlignment: Center, TextColor: #8b99a3); }
    Label { Text: "Unlock this output slot in Building upgrades."; Anchor: (Height: 64); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, HorizontalAlignment: Center, TextColor: #8b99a3); }
  }
}
