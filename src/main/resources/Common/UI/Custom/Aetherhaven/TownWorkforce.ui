$C = "../Common.ui";
Group {
  LayoutMode: Top; FlexWeight: 1;
  Label #WorkIntro { Anchor: (Height: 54, Bottom: 8); Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #bdccda); }
  Label #WorkNotice { Visible: false; Anchor: (Height: 36, Bottom: 8); Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #e4d4ac); }
  Group { LayoutMode: Left; Anchor: (Height: 48, Bottom: 2); Padding: (Horizontal: 8);
    Label { Anchor: (Width: 318); Text: "Townsfolk"; Style: (...$C.@DefaultLabelStyle, VerticalAlignment: End, TextColor: #e4d4ac); }
    Group #WorkColumns { LayoutMode: Left; FlexWeight: 1; }
  }
  Group { LayoutMode: TopScrolling; FlexWeight: 1; ScrollbarStyle: $C.@DefaultScrollbarStyle;
    Label #WorkEmpty { Anchor: (Top: 10, Left: 8); Style: (...$C.@DefaultLabelStyle, Wrap: true); }
    Group #WorkRows { LayoutMode: Top; }
  }
  Label #WorkFooter { Anchor: (Height: 54, Top: 12); Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #a1b6c9); }
}
