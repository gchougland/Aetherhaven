$C = "../Common.ui";
$T = "TownUiTheme.ui";
@Gold = #dec68d;
@Leaf = #b7c9bb;
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer #GardenWindow { Anchor: (Width: 920, Height: 664);
  #Title { Label #TitleText { Text: ""; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
  #Content { LayoutMode: Top; Padding: (Full: 24);
   Group { LayoutMode: Left; Anchor: (Height: 26);
    Label #Summary { Text: ""; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: @Gold); }
    Label #Mastery { Text: ""; Anchor: (Width: 300); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: @Leaf, HorizontalAlignment: End, VerticalAlignment: Center); }
   }
   Label #Intro { Text: ""; Anchor: (Height: 44, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true); }
   Group #Planters { LayoutMode: Left; Anchor: (Height: 132, Bottom: 12); }
   Group #Detail { LayoutMode: Left; Anchor: (Height: 150, Bottom: 10); Background: $T.@Panel; Padding: (Full: 16);
    Group { Anchor: (Width: 76, Height: 76, Right: 14); Background: $T.@Slot;
     ItemIcon #PlantIcon { Anchor: (Width: 60, Height: 60); }
    }
    Group { FlexWeight: 1; LayoutMode: Top;
     Label #PlanterTitle { Text: ""; Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: @Gold); }
     Label #PlantName { Text: ""; Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true); }
     $C.@ProgressBar #Growth { Anchor: (Height: 14, Top: 4, Bottom: 6); Value: 0.0; }
     Label #PlanterStatus { Text: ""; Anchor: (Height: 44); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true, TextColor: @Leaf); }
    }
    Group #DetailActions { LayoutMode: Top; Anchor: (Width: 300, Left: 16);
     $C.@TextButton #Bless { Text: ""; Anchor: (Height: 44, Bottom: 10); }
     $C.@SecondaryTextButton #Uproot { Text: ""; Anchor: (Height: 40); }
    }
   }
   Label #SeedHint { Text: ""; Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: @Gold); Visible: false; }
   Group #Seeds { LayoutMode: Left; Anchor: (Height: 64, Bottom: 10); Visible: false; }
   Label #StoresTitle { Text: ""; Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: @Gold); }
   Group { LayoutMode: Left; Anchor: (Height: 78, Bottom: 10); Background: $T.@Panel; Padding: (Full: 10);
    Group #Stock { FlexWeight: 1; LayoutMode: Left; }
    Label #StockEmpty { Text: ""; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: @Leaf, VerticalAlignment: Center); Visible: false; }
    Group { LayoutMode: Middle; Anchor: (Width: 170);
     $C.@TextButton #Collect { Text: ""; Anchor: (Width: 160, Height: 40); }
    }
   }
   Group { LayoutMode: Left; Anchor: (Height: 44);
    Label #GardenNote { Text: ""; FlexWeight: 1; Anchor: (Right: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: @Gold, Wrap: true, VerticalAlignment: Center); }
    $C.@SecondaryTextButton #Refresh { Text: ""; Anchor: (Width: 120, Height: 40, Right: 10); }
    $C.@TextButton #Upgrades { Text: ""; Anchor: (Width: 220, Height: 40); }
   }
  }
 }
}
$C.@BackButton {}
