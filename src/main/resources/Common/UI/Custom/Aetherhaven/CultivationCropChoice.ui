$C = "../Common.ui";
$T = "TownUiTheme.ui";
Button #Pick { LayoutMode: Top; FlexWeight: 1; Anchor: (Right: 5); Padding: (Full: 4);
  Style: (Default: (Background: $T.@Card), Hovered: (Background: $T.@CardHovered), Pressed: (Background: $T.@CardPressed));
  Group { LayoutMode: Center; Anchor: (Height: 34); ItemIcon #Icon { Anchor: (Width: 34, Height: 34); } }
  Label #Name { Anchor: (Height: 18); Style: (...$C.@DefaultLabelStyle, FontSize: 12, HorizontalAlignment: Center); }
  Label #Skill { Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #a5cabc, HorizontalAlignment: Center); }
  Group #Mark { Anchor: (Height: 2); Background: #dfbd78; Visible: false; }
}
