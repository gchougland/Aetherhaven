$C = "../Common.ui";
$T = "TownUiTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer { Anchor: (Width: 1210, Height: 880);
  #Title { Label { Text: "MINESHAFT PLANNER"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
  #Content { LayoutMode: Top; Padding: (Full: 22);
   Label #Name { Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 19, RenderBold: true, TextColor: #dec68d); }
   Label { Text: "Choose a floor, then a passage or the empty square beyond its end. Choose a direction and shape, review, then add it. Reopen this planner at a Workbench inside the base."; Anchor: (Height: 22, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true); }
   Group { LayoutMode: Left; Anchor: (Height: 610);
    Group { LayoutMode: Top; Anchor: (Width: 498, Right: 18); Padding: (Full: 12); Background: $T.@Panel;
     Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 8);
      $C.@SmallSecondaryTextButton #Down { Text: "Floor down"; Anchor: (Width: 125); }
      Label #Floor { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center); }
      $C.@SmallSecondaryTextButton #Up { Text: "Floor up"; Anchor: (Width: 125); }
     }
     Group #Map { Anchor: (Width: 462, Height: 462); Background: $T.@Inset; }
     Label { Text: "3 blocks per square. Blue: base. Green: passage. Gold: draft."; Anchor: (Height: 20); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
     Label { Text: "Violet: stairs or a passage at another height go through here. Arrows point uphill. Red: the draft cannot pass."; Anchor: (Height: 36); Style: (...$C.@DefaultLabelStyle, FontSize: 12, Wrap: true, TextColor: #b7c9bb); }
    }
    Group { LayoutMode: Top; FlexWeight: 1; Padding: (Full: 16); Background: $T.@Panel;
     Label #StartPoint { Anchor: (Height: 25); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #dec68d); }
     Group { LayoutMode: Left; Anchor: (Height: 34, Bottom: 8);
      $C.@SmallSecondaryTextButton #North { Text: "North"; FlexWeight: 1; Anchor: (Right: 4); }
      $C.@SmallSecondaryTextButton #East { Text: "East"; FlexWeight: 1; Anchor: (Right: 4); }
      $C.@SmallSecondaryTextButton #South { Text: "South"; FlexWeight: 1; Anchor: (Right: 4); }
      $C.@SmallSecondaryTextButton #West { Text: "West"; FlexWeight: 1; }
     }
     Group { LayoutMode: Left; Anchor: (Height: 34, Bottom: 8);
      $C.@SmallSecondaryTextButton #Shorter { Text: "3 shorter"; Anchor: (Width: 105); }
      Label #Length { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center); }
      $C.@SmallSecondaryTextButton #Longer { Text: "3 longer"; Anchor: (Width: 105); }
     }
     Group { LayoutMode: Left; Anchor: (Height: 34, Bottom: 8);
      $C.@SmallSecondaryTextButton #Straight { Text: "Level tunnel"; FlexWeight: 1; Anchor: (Right: 4); }
      $C.@SmallSecondaryTextButton #StairsUp { Text: "Stairs up"; FlexWeight: 1; Anchor: (Right: 4); }
      $C.@SmallSecondaryTextButton #StairsDown { Text: "Stairs down"; FlexWeight: 1; Anchor: (Right: 4); }
     }
     $C.@SmallSecondaryTextButton #Room { Text: "Room 9 x 9 x 5"; Anchor: (Height: 28, Bottom: 4); }
     Label #Shape { Anchor: (Height: 36, Bottom: 4); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #b7c9bb); }
     Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 4);
      Group { LayoutMode: Left; FlexWeight: 1; Anchor: (Right: 10);
       ItemIcon #BeamsIcon { Anchor: (Width: 28, Height: 28, Right: 4); }
       Group { LayoutMode: Top; FlexWeight: 1;
        Label #BeamsName { Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #dec68d); }
        Label #BeamsCount { Anchor: (Height: 15); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
       }
       $C.@SmallSecondaryTextButton #Beams { Text: "Off"; Anchor: (Width: 58, Height: 30, Left: 4); }
      }
      Group { LayoutMode: Left; FlexWeight: 1;
       ItemIcon #TorchesIcon { Anchor: (Width: 28, Height: 28, Right: 4); }
       Group { LayoutMode: Top; FlexWeight: 1;
        Label #TorchesName { Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #dec68d); }
        Label #TorchesCount { Anchor: (Height: 15); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
       }
       $C.@SmallSecondaryTextButton #Torches { Text: "Off"; Anchor: (Width: 58, Height: 30, Left: 4); }
      }
     }
     Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 2);
      Group { LayoutMode: Left; FlexWeight: 1; Anchor: (Right: 10);
       ItemIcon #LanternsIcon { Anchor: (Width: 28, Height: 28, Right: 4); }
       Group { LayoutMode: Top; FlexWeight: 1;
        Label #LanternsName { Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #dec68d); }
        Label #LanternsCount { Anchor: (Height: 15); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
       }
       $C.@SmallSecondaryTextButton #Lanterns { Text: "Off"; Anchor: (Width: 58, Height: 30, Left: 4); }
      }
      Group { LayoutMode: Left; FlexWeight: 1;
       ItemIcon #RailsIcon { Anchor: (Width: 28, Height: 28, Right: 4); }
       Group { LayoutMode: Top; FlexWeight: 1;
        Label #RailsName { Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #dec68d); }
        Label #RailsCount { Anchor: (Height: 15); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
       }
       $C.@SmallSecondaryTextButton #Rails { Text: "Off"; Anchor: (Width: 58, Height: 30, Left: 4); }
      }
     }
     Label { Text: "Miners take these from General storage at the Warehouse Ledger Desk, one for each piece they place."; Anchor: (Height: 18, Bottom: 6); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
     Label #Review { Anchor: (Height: 45, Bottom: 4); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #dec68d); }
     Group { LayoutMode: Left; Anchor: (Height: 34, Bottom: 12);
      $C.@SmallSecondaryTextButton #Fix { Text: "Move start"; FlexWeight: 13; Anchor: (Right: 8); Visible: false; }
      $C.@SmallSecondaryTextButton #Refresh { Text: "Review terrain"; FlexWeight: 10; Anchor: (Right: 8); }
      $C.@SmallSecondaryTextButton #Add { Text: "Add reviewed tunnel"; FlexWeight: 12; }
     }
     Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 8);
      $C.@SmallSecondaryTextButton #Previous { Text: "Previous"; Anchor: (Width: 105); }
      Label #Tunnel { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 14, HorizontalAlignment: Center, VerticalAlignment: Center); }
      $C.@SmallSecondaryTextButton #Next { Text: "Next"; Anchor: (Width: 105); }
     }
     Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 8);
      $C.@SmallSecondaryTextButton #Pause { Text: "Pause tunnel"; FlexWeight: 1; Anchor: (Right: 8); }
      $C.@SmallSecondaryTextButton #Remove { Text: "Remove tunnel"; FlexWeight: 1; }
     }
     Group { LayoutMode: Left; Anchor: (Height: 54);
      ItemIcon #ActivityIcon { Anchor: (Width: 30, Height: 30, Right: 8); Visible: false; }
      Label #Activity { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #b7c9bb); }
     }
     Label #Buffer { Anchor: (Height: 26); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #dec68d); TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    }
   }
   Group { LayoutMode: Left; Anchor: (Height: 32, Top: 8, Bottom: 8);
    Label { Text: "Move map"; Anchor: (Width: 95); Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center); }
    $C.@SmallSecondaryTextButton #MapNorth { Text: "North"; Anchor: (Width: 80, Right: 5); }
    $C.@SmallSecondaryTextButton #MapEast { Text: "East"; Anchor: (Width: 80, Right: 5); }
    $C.@SmallSecondaryTextButton #MapSouth { Text: "South"; Anchor: (Width: 80, Right: 5); }
    $C.@SmallSecondaryTextButton #MapWest { Text: "West"; Anchor: (Width: 80, Right: 10); }
    $C.@SmallSecondaryTextButton #Home { Text: "Base floor"; Anchor: (Width: 125, Right: 12); }
    $C.@SmallSecondaryTextButton #Settings { Text: "Base settings"; Anchor: (Width: 135, Right: 10); }
    $C.@SmallSecondaryTextButton #Bench { Text: "Craft at this bench"; Anchor: (Width: 180, Right: 10); Visible: false; }
    $C.@SmallSecondaryTextButton #Storage { Text: "Open output storage"; FlexWeight: 1; }
   }
   Label #Status { Anchor: (Height: 50); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true, TextColor: #dec68d); }
  }
 }
}
$C.@BackButton {}
