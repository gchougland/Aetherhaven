$C = "../Common.ui";
$T = "TownUiTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer { Anchor: (Width: 960, Height: 690);
  #Title { Label { Text: "GUARD EQUIPMENT"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
  #Content { LayoutMode: Top; Padding: (Full: 22);
   Group { LayoutMode: Left; FlexWeight: 1;
    Group { LayoutMode: Top; Anchor: (Width: 236, Right: 18); Padding: (Full: 16); Background: $T.@Panel;
     AssetImage #Portrait { Anchor: (Width: 184, Height: 184, Left: 10); }
     Label #Name { Anchor: (Height: 48); Style: (...$C.@DefaultLabelStyle, FontSize: 20, HorizontalAlignment: Center, Wrap: true, RenderBold: true); }
     Label { Text: "EQUIPPED"; Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #d2bc85, HorizontalAlignment: Center, RenderBold: true); }
     Group { Anchor: (Height: 76); Background: $T.@Inset;
      ItemIcon #CurrentIcon { Anchor: (Width: 68, Height: 68, Left: 68, Top: 4); }
     }
     Label #CurrentName { Anchor: (Height: 48, Top: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 16, Wrap: true, RenderBold: true, HorizontalAlignment: Center); }
     Label #CurrentEffect { Anchor: (Height: 72); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #9fbbaf, HorizontalAlignment: Center); }
     $C.@SecondaryTextButton #Unequip { Text: "Return kit"; Anchor: (Height: 34); }
    }
    Group { LayoutMode: Top; FlexWeight: 1;
     Label { Text: "AVAILABLE KITS"; Anchor: (Height: 30); Style: (...$C.@DefaultLabelStyle, FontSize: 18, TextColor: #d2bc85, RenderBold: true); }
     Label { Text: "Carried items and town storage"; Anchor: (Height: 30, Bottom: 10); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #96aea4); }
     Group { LayoutMode: TopScrolling; FlexWeight: 1; ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Group #Kits { LayoutMode: Top; }
      Label #Empty { Text: "No guard kits available. Create crafting tasks at an armor crafting workplace."; Anchor: (Height: 80); Style: (...$C.@DefaultLabelStyle, FontSize: 15, Wrap: true, TextColor: #a8bbad); }
     }
    }
   }
   Group { LayoutMode: Left; Anchor: (Height: 46, Top: 14);
    Label #Hint { FlexWeight: 1; Anchor: (Right: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #bac9bb, Wrap: true); }
    $C.@SecondaryTextButton #Refresh { Text: "Refresh"; Anchor: (Width: 130, Right: 8); }
    $C.@SecondaryTextButton #Back { Text: "Profile"; Anchor: (Width: 115); }
   }
  }
 }
}
$C.@BackButton {}
