$C = "../Common.ui";

Button #WardrobeResidentRow {
  LayoutMode: Left;
  Anchor: (Bottom: 8);
  Padding: (Horizontal: 6, Vertical: 4);
  Style: (
    Default: (Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4)),
    Hovered: (Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #ffffff(0.55))),
    Pressed: (Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #ffffff(0.75))),
    Disabled: (Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4, Color: #000000(0.35)))
  );

  AssetImage #Portrait {
    Anchor: (Width: 56, Height: 56, Right: 8);
    FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
  }

  Label #NameLine {
    Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #e8dcc8, Wrap: true, VerticalAlignment: Center);
    FlexWeight: 1;
  }
}
