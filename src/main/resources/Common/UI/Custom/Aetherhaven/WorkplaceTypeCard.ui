$C = "../Common.ui";
$T = "TownUiTheme.ui";
// One workplace type. 326 by 120, with a 9 gap to the next card in its row.
// Padding 12, then a 72 high top with the picture and three text lines (14 + 24 + 34), a 6 gap and the 18 high state line.
// The state line is drawn over the shade of a locked card, so what unlocks the type stays easy to read.
Button { Anchor: (Width: 326, Height: 120, Right: 9);
  Style: (Default: (Background: $T.@Card), Hovered: (Background: $T.@CardHovered), Pressed: (Background: $T.@CardPressed));
  TextTooltipStyle: $C.@DefaultTextTooltipStyle;
  Group #Selected { Background: $T.@CardPressed; Visible: false; HitTestVisible: false; }
  Group { LayoutMode: Top; Padding: (Full: 12); HitTestVisible: false;
    Group { LayoutMode: Left; Anchor: (Height: 72);
      Group { Anchor: (Width: 72, Right: 12); Background: $T.@Slot;
        AssetImage #Icon { Anchor: (Width: 52, Height: 52); }
      }
      Group { LayoutMode: Top; FlexWeight: 1;
        Label #Skill { Text: ""; Anchor: (Height: 14); Style: (...$C.@DefaultLabelStyle, FontSize: 10, RenderBold: true, RenderUppercase: true, TextColor: #a9c7b4); }
        Label #Name { Text: ""; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 17, RenderBold: true, TextColor: #eee0bf); }
        Label #Line { Text: ""; Anchor: (Height: 34); Style: (...$C.@DefaultLabelStyle, FontSize: 12, Wrap: true, TextColor: #b6c6d3); }
      }
    }
  }
  Group #LockedShade { Background: #10161d(0.55); Visible: false; HitTestVisible: false; }
  AssetImage #Lock { AssetPath: "UI/Custom/padlock.png"; Anchor: (Left: 60, Top: 60, Width: 26, Height: 26); Visible: false; HitTestVisible: false; }
  Label #State { Text: ""; Anchor: (Left: 12, Right: 12, Bottom: 12, Height: 18); Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, TextColor: #9cdeb4); HitTestVisible: false; }
  Label #Chosen { Text: ""; Anchor: (Top: 10, Right: 12, Width: 90, Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 10, RenderBold: true, HorizontalAlignment: End, TextColor: #9cdeb4); Visible: false; HitTestVisible: false; }
}
