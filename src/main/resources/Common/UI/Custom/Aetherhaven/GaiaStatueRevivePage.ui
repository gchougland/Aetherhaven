$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 480);

    #Title {
      Label #GaiaReviveTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 40, Bottom: 12);
        $C.@TextButton #ReviveTab { Anchor: (Width: 204, Right: 8); Text: ""; }
        $C.@TextButton #AppearanceTab { Anchor: (Width: 204); Text: ""; }
      }

      Label #Hint {
        Anchor: (Bottom: 12);
        Style: (...$C.@DefaultLabelStyle, Wrap: true);
      }

      Group #ListScroll {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 320);

        Group #Rows {
          LayoutMode: Top;
        }
      }

      Label #Footer {
        Anchor: (Top: 12);
        Style: (...$C.@DefaultLabelStyle, TextColor: #888888, Wrap: true);
        Text: "";
      }
    }
  }
}

$C.@BackButton {}
