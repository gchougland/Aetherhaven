$C = "../Common.ui";
$T = "BuildingMasteryTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
  Group { Anchor: (Width: 760, Height: 650); Background: $T.@Panel;
    Label #GaiaReviveTitleText { Anchor: (Top: 12, Left: 30, Right: 30, Height: 32); Text: ""; Style: (...$C.@TitleStyle, HorizontalAlignment: Center, TextColor: #e8c984); }
    Group { Anchor: (Top: 55, Bottom: 20, Left: 20, Right: 20); LayoutMode: Top;
      Group #Tabs { LayoutMode: Left; Anchor: (Height: 42, Bottom: 16);
        $C.@SecondaryTextButton #ReviveTab { FlexWeight: 1; Anchor: (Right: 10); Text: ""; }
        $C.@SecondaryTextButton #AppearanceTab { FlexWeight: 1; Text: ""; }
      }
      Label #Hint { Anchor: (Height: 60, Bottom: 12); Style: (...$C.@DefaultLabelStyle, TextColor: #c5cdd5, Wrap: true); }
      Group { Background: $T.@Canvas; Padding: (Full: 10); FlexWeight: 1;
        Group #ListScroll { LayoutMode: TopScrolling; Anchor: (Full: 0); ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Rows { LayoutMode: Top; }
        }
      }
      Label #Footer { Anchor: (Height: 58, Top: 14); Style: (...$C.@DefaultLabelStyle, TextColor: #b9c4cf, Wrap: true); Text: ""; }
    }
  }
}
$C.@BackButton {}
