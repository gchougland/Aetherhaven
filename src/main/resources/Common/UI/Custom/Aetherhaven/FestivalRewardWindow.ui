$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 420);

    #Title {
      Label #FestivalRewardTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #FestivalRewardHeadline {
        Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f4e8c8, Wrap: true, HorizontalAlignment: Center);
        Anchor: (Bottom: 4);
        Text: "";
      }

      Label #FestivalRewardSubtext {
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8b898, Wrap: true, HorizontalAlignment: Center);
        Anchor: (Bottom: 12);
        Text: "";
      }

      Group #RewardScroll {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 240);

        Group #RewardRows {
          LayoutMode: Top;
        }
      }

      Group #FestivalRewardButtons {
        LayoutMode: Center;
        Anchor: (Top: 14);

        $C.@TextButton #FestivalRewardCloseButton {
          Anchor: (Width: 160, Height: 36);
          Text: "";
        }
      }
    }
  }
}

$C.@BackButton {}
