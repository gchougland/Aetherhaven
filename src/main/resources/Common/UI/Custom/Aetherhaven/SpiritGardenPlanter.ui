$C = "../Common.ui";
$T = "TownUiTheme.ui";
Button { Anchor: (Width: 134, Height: 132, Right: 10); Background: $T.@Card;
 TextTooltipStyle: $C.@DefaultTextTooltipStyle;
 Group #LockedShade { Background: #343b43; Visible: false; HitTestVisible: false; }
 Group #Selected { Background: $T.@CardPressed; Visible: false; HitTestVisible: false; }
 Group { LayoutMode: Top; Padding: (Full: 8); HitTestVisible: false;
  Label #Number { Text: ""; Anchor: (Height: 18); Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, HorizontalAlignment: Center, TextColor: #dec68d); }
  Group { LayoutMode: Center; Anchor: (Height: 42);
   ItemIcon #Icon { Anchor: (Width: 40, Height: 40); }
   AssetImage #Lock { AssetPath: "UI/Custom/padlock.png"; Anchor: (Width: 34, Height: 34); Visible: false; HitTestVisible: false; }
  }
  Label #Name { Text: ""; Anchor: (Height: 18); Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, HorizontalAlignment: Center); }
  $C.@ProgressBar #Bar { Anchor: (Height: 8, Top: 4, Bottom: 4, Left: 8, Right: 8); Value: 0.0; HitTestVisible: false; }
  Label #Status { Text: ""; Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 11, HorizontalAlignment: Center, TextColor: #b7c9bb); }
 }
}
