$C = "../Common.ui";
$T = "TownUiTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer { Anchor: (Width: 1080, Height: 840);
  #Title { Label { Text: "BARN ANIMALS"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
  #Content { LayoutMode: Top; Padding: (Full: 20);
   Label #Summary { Anchor: (Height: 26, Bottom: 8); Style: (...$C.@DefaultLabelStyle, TextColor: #dec68d); }
   Group #Slots { LayoutMode: Left; Anchor: (Height: 175, Bottom: 12); }
   Group { LayoutMode: Left; Anchor: (Height: 36, Bottom: 10);
    $C.@SmallSecondaryTextButton #Animals { Text: "My animals"; Anchor: (Width: 135, Right: 8); }
    $C.@SmallSecondaryTextButton #Food { Text: "Food bin"; Anchor: (Width: 120, Right: 8); }
    $C.@SmallSecondaryTextButton #Storage { Text: "Resources"; Anchor: (Width: 130, Right: 8); }
    $C.@SmallSecondaryTextButton #Refresh { Text: "Refresh"; Anchor: (Width: 105); }
   }
   Group { LayoutMode: Left; Anchor: (Height: 30, Bottom: 8);
    Label #Page { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, TextColor: #b7c9bb); }
    $C.@SmallSecondaryTextButton #Previous { Text: "Previous"; Anchor: (Width: 100, Right: 8); }
    $C.@SmallSecondaryTextButton #Next { Text: "Next"; Anchor: (Width: 80); }
   }
   Group #Rows { LayoutMode: Top; Anchor: (Height: 320); }
   Label #EmptyList { Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true); Visible: false; }
   Group { LayoutMode: Left; Anchor: (Height: 34, Top: 8, Bottom: 8);
    $C.@SmallSecondaryTextButton #Courier { Anchor: (Width: 255, Right: 14); Text: "Automatic food"; }
    Label { FlexWeight: 1; Text: "Feeding and petting each count once per day. More hearts increase resource yields."; Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #b7c9bb); }
   }
   Label #FooterStatus { Anchor: (Height: 42); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true, TextColor: #dec68d); }
  }
 }
}
$C.@BackButton {}
