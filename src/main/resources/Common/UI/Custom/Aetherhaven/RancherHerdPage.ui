$C = "../Common.ui";
$T = "TownUiTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer { Anchor: (Width: 980, Height: 680);
  #Title { Label { Text: "BARN HERDS"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
  #Content { LayoutMode: Top; Padding: (Full: 24);
   Group { LayoutMode: Left; Anchor: (Height: 36);
    Label #Mode { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 17, RenderBold: true, TextColor: #dec68d); }
    Label #FamilyPage { Anchor: (Width: 160); Style: (...$C.@DefaultLabelStyle, FontSize: 13, VerticalAlignment: Center, TextColor: #b7c9bb); }
    $C.@SecondaryTextButton #PreviousFamily { Text: "Previous"; Anchor: (Width: 112, Height: 30, Right: 8); }
    $C.@SecondaryTextButton #NextFamily { Text: "Next"; Anchor: (Width: 86, Height: 30); }
   }
   Label { Text: "Keep breeding pairs near feeding troughs inside the barn. Select their products in barn storage."; Anchor: (Height: 30, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true); }
   Group #Herds { LayoutMode: Left; Anchor: (Height: 244, Bottom: 12); }
   Group { LayoutMode: Left; Anchor: (Height: 62, Bottom: 10); Background: $T.@Panel; Padding: (Full: 10);
    ItemIcon { ItemId: "Plant_Crop_Wheat_Item"; Anchor: (Width: 40, Height: 40, Right: 10); }
    Group { LayoutMode: Top; FlexWeight: 1;
     Label { Text: "FEED BIN"; Anchor: (Height: 18); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
     Label #Feed { Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 17, TextColor: #dec68d); }
    }
    $C.@SecondaryTextButton #Supply { Text: "Supply one"; Anchor: (Width: 126, Height: 38, Right: 8); }
    $C.@SecondaryTextButton #Take { Text: "Take one"; Anchor: (Width: 116, Height: 38, Right: 8); }
    $C.@SecondaryTextButton #CourierFeed { Text: "Courier feed: Off"; Anchor: (Width: 196, Height: 38); TextTooltipStyle: $C.@DefaultTextTooltipStyle; TooltipText: "Choose Off, 8, 16, 32 or 64 wheat. Couriers collect from farm storage or the Ledger Desk and deliver here."; }
   }
   Label #Cargo { Anchor: (Height: 24, Bottom: 6); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b7c9bb); }
   Label #Status { Anchor: (Height: 42, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true, TextColor: #dec68d); }
   Group { LayoutMode: Left; Anchor: (Height: 38, Bottom: 10);
    $C.@TextButton #Save { FlexWeight: 1; Anchor: (Right: 12); Text: "Start herd work"; }
    $C.@SecondaryTextButton #Refresh { Anchor: (Width: 150); Text: "Refresh"; }
   }
   Label #Warning { Anchor: (Height: 44); Style: (...$C.@DefaultLabelStyle, FontSize: 12, Wrap: true, TextColor: #b7c9bb); }
  }
 }
}
$C.@BackButton {}
