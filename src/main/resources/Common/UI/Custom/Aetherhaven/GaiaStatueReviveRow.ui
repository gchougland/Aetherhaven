$C = "../Common.ui";
$T = "BuildingMasteryTheme.ui";

Group #ReviveRow {
  LayoutMode: Left;
  Anchor: (Height: 80, Bottom: 10);
  Padding: (Horizontal: 12, Vertical: 10);
  Background: $T.@Panel;

  AssetImage #Portrait {
    Anchor: (Width: 56, Height: 56, Right: 8);
    FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
  }

  Label #VillagerLine {
    Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #e8dcc8, Wrap: true);
    FlexWeight: 1;
    Anchor: (Right: 8);
  }

  $C.@TextButton #ReviveButton {
    Anchor: (Width: 150, Height: 42, Top: 8);
    Text: "";
  }
}
