$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 520);

    #Title {
      Label #IntroPromptTitle {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 12);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 18);

      Label #IntroPromptText {
        Anchor: (Bottom: 16);
        Style: (...$C.@DefaultLabelStyle, Wrap: true);
        Text: "";
      }

      Label #BirthdayHeading {
        Anchor: (Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, RenderBold: true);
        Text: "";
      }

      Group #BirthdaySeasonRow {
        LayoutMode: Left;
        Anchor: (Bottom: 8);

        Label #BirthdaySeasonLabel {
          Anchor: (Top: 8, Right: 12, Width: 80);
          Style: $C.@DefaultLabelStyle;
          Text: "";
        }

        $C.@DropdownBox #BirthdaySeasonDropdown {
          FlexWeight: 1;
          Anchor: (Left: 0, Right: 0, Height: $C.@DropdownBoxHeight);
        }
      }

      Group #BirthdayDayRow {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        Label #BirthdayDayLabel {
          Anchor: (Top: 8, Right: 12, Width: 80);
          Style: $C.@DefaultLabelStyle;
          Text: "";
        }

        $C.@DropdownBox #BirthdayDayDropdown {
          FlexWeight: 1;
          Anchor: (Left: 0, Right: 0, Height: $C.@DropdownBoxHeight);
        }
      }

      Group {
        LayoutMode: Left;

        $C.@TextButton #IntroPromptAccept {
          Text: "";
          FlexWeight: 1;
          Anchor: (Right: 8, Height: 40);
        }

        $C.@CancelTextButton #IntroPromptDecline {
          Text: "";
          FlexWeight: 1;
          Anchor: (Height: 40);
        }
      }
    }
  }
}
