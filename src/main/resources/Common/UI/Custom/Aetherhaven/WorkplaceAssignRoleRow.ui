$C = "../Common.ui";
$T = "TownUiTheme.ui";

Group #WorkplaceAssignRole {
  LayoutMode: Top;
  Anchor: (Bottom: 12);

  Label #RoleLabel {
    Text: "";
    Anchor: (Bottom: 8);
    Style: (...$C.@DefaultLabelStyle, RenderBold: true);
    Visible: false;
  }

  Group #WorkplaceWorkerSelection {
    LayoutMode: Left;
    Anchor: (Bottom: 8);
    Padding: (Horizontal: 6, Vertical: 4);
    Background: $T.@Panel;

    AssetImage #PreviewPortrait {
      Anchor: (Width: 48, Height: 48, Right: 8);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }

    Group #PreviewInfo {
      LayoutMode: Top;
      FlexWeight: 1;
      Anchor: (Right: 8);

      Label #PreviewNameLine {
        Style: (...$C.@DefaultLabelStyle, RenderBold: true, TextColor: #e8dcc8, Wrap: true);
      }

      Label #PreviewRoleLine {
        Style: (...$C.@DefaultLabelStyle, TextColor: #a89878, Wrap: true);
      }
    }
    $C.@SecondaryTextButton #TeleportWorker {
      Text: "Teleport to me"; Anchor: (Width: 160, Height: 34, Top: 7); Visible: false;
      TextTooltipStyle: $C.@DefaultTextTooltipStyle; TooltipText: "Bring the assigned villager to your side";
    }
  }
  $C.@SecondaryTextButton #ChooseWorkplaceWorkerButton {
    Text: "";
    Anchor: (Bottom: 8);
  }
}
