$C = "../Common.ui";
$T = "TownUiTheme.ui";
Group { TextTooltipStyle: $C.@DefaultTextTooltipStyle; LayoutMode: Left; FlexWeight: 1; Anchor: (Right: 6); Padding: (Full: 5); Background: $T.@Card;
  AssetImage #Icon { Anchor: (Width: 32, Height: 32, Right: 6); }
  Label #Name { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, Wrap: true, VerticalAlignment: Center); }
  Label #Quantity { Anchor: (Width: 35); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #dec68d, VerticalAlignment: Center, HorizontalAlignment: End); }
}
