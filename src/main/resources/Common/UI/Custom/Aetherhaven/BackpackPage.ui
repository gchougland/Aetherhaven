$C = "../Common.ui";
$T = "TownUiTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
  Group { Anchor: (Width: 1050, Height: 930); Background: $T.@Panel; Padding: (Full: 22); LayoutMode: Top;
    Label #Title { Anchor: (Height: 36); Style: (...$C.@TitleStyle, TextColor: #e8c984, HorizontalAlignment: Center); }
    Label #Summary { Anchor: (Height: 32); Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #e8c984, HorizontalAlignment: Center); }
    Group #Main { FlexWeight: 1; LayoutMode: Left;
      Group { Anchor: (Width: 230, Right: 14); Background: $T.@Inset; Padding: (Full: 10); LayoutMode: Top;
        Label { Text: "YOUR BACKPACKS"; Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, RenderBold: true); }
        Group { Anchor: (Height: 65); LayoutMode: Center; ItemIcon #BagIcon { Anchor: (Width: 60, Height: 60); } }
        Label #BagName { Anchor: (Height: 36); Style: (...$C.@DefaultLabelStyle, TextColor: #e8c984, FontSize: 16, HorizontalAlignment: Center, Wrap: true); }
        $C.@TextField #Rename { Anchor: (Height: 30, Bottom: 5); PlaceholderText: "Backpack name"; MaxLength: 30; }
        $C.@SmallSecondaryTextButton #RenameButton { Text: "Save name"; Anchor: (Height: 30, Bottom: 6); }
        $C.@SmallSecondaryTextButton #ChooseBag { Text: "Choose backpack"; Anchor: (Height: 36, Bottom: 8); }
        Group #Options { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; }
      }
      Group { FlexWeight: 1; Background: $T.@Inset; Padding: (Full: 12); LayoutMode: Top;
        Group { LayoutMode: Left; Anchor: (Height: 54);
          Group { LayoutMode: Top; FlexWeight: 1;
            Label { Text: "BACKPACK CONTENTS"; Anchor: (Height: 30); Style: (...$C.@DefaultLabelStyle, RenderBold: true); }
            Label { Text: "Click an item to take it."; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 13); }
          }
          $C.@SmallSecondaryTextButton #StoreMatching { Text: "Store matching items"; Anchor: (Width: 240, Height: 36); }
        }
        Group { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group #Contents { LayoutMode: LeftCenterWrap; }
        }
      }
    }
      Group #InventoryPanel { Anchor: (Height: 375, Top: 12); Background: $T.@Inset; Padding: (Full: 10); LayoutMode: Top;
        Label { Text: "YOUR INVENTORY"; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, RenderBold: true, HorizontalAlignment: Center); }
        Label #InventoryHint { Text: "Left click moves a stack. Right click moves one item."; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 12, HorizontalAlignment: Center); }
        Group { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group { LayoutMode: Center;
            Group { LayoutMode: Left;
              Group #PlayerItems { Anchor: (Width: 522); LayoutMode: Top; }
              Group #NativeBackpackPanel { Anchor: (Width: 210, Height: 300, Left: 20); LayoutMode: Top; Background: $T.@Panel; Padding: (Full: 10);
                Label { Text: "BACKPACK"; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #e8c984, HorizontalAlignment: Center); }
                Group { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; Group #NativeBackpackItems { LayoutMode: Top; } }
              }
            }
          }
        }
      }
    Group #Picker { FlexWeight: 1; LayoutMode: Top; Visible: false; Background: $T.@Inset; Padding: (Full: 16);
      Group { Anchor: (Height: 40, Bottom: 12); LayoutMode: Left;
        Label #PickerTitle { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 20, TextColor: #e8c984, RenderBold: true); }
        $C.@SmallSecondaryTextButton #PickerBack { Text: "Back to backpack"; Anchor: (Width: 200); }
      }
      Group { FlexWeight: 1; LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Group #Choices { LayoutMode: LeftCenterWrap; }
      }
    }
    Label #Hint { Anchor: (Height: 36, Top: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #c5cdd5, Wrap: true); }
  }
}
$C.@BackButton {}
