$C = "../Common.ui";
$T = "TownUiTheme.ui";
Group { LayoutMode: Left; Anchor: (Height: 64, Bottom: 6); Background: $T.@Card; Padding: (Full: 9);
  ItemIcon #Icon { Anchor: (Width: 44, Height: 44, Right: 10); }
  Group { LayoutMode: Top; FlexWeight: 1;
    Label #Threshold { Anchor: (Height: 18); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #99c7b5); }
    Label #Reward { Anchor: (Height: 28); Style: (...$C.@DefaultLabelStyle, FontSize: 14, RenderBold: true, TextColor: #e1ddca, Wrap: true); }
  }
  Label #Status { Anchor: (Width: 86); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #bfcaaa, HorizontalAlignment: End, VerticalAlignment: Center, Wrap: true); }
}
