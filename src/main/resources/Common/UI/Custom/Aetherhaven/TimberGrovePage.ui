$C = "../Common.ui";
$T = "TownUiTheme.ui";
$C.@PageOverlay { LayoutMode: Middle;
 $C.@DecoratedContainer { Anchor: (Width: 900, Height: 760);
  #Title { Label { Text: "LUMBERMILL GROVE"; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
  #Content { LayoutMode: Top; Padding: (Full: 24);
   Label #GroveMode { Text: "PLAN ROOM TO GROW"; Anchor: (Height: 26); Style: (...$C.@DefaultLabelStyle, FontSize: 16, RenderBold: true, TextColor: #dec68d); }
   Label { Text: "Each unlocked material slot can have one tree location. Choose materials in the lumbermill storage screen."; Anchor: (Height: 46, Bottom: 8); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true); }
   Group #Slots { LayoutMode: Left; Anchor: (Height: 100, Bottom: 16); }
   Group { LayoutMode: Left; Anchor: (Height: 180, Bottom: 12);
    Group { FlexWeight: 1; LayoutMode: Top; Anchor: (Right: 16); Background: $T.@Panel; Padding: (Full: 16);
     Group { LayoutMode: Left; Anchor: (Height: 72, Bottom: 4);
      ItemIcon #TreeIcon { Anchor: (Width: 64, Height: 64, Right: 16); }
      Group { FlexWeight: 1; LayoutMode: Top;
       Label #SlotTitle { Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #dec68d); }
       Label #TimberName { Anchor: (Height: 44); Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, Wrap: true); }
      }
     }
     Label #Location { Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true); }
     Label #Footprint { Anchor: (Height: 44); Style: (...$C.@DefaultLabelStyle, FontSize: 14, Wrap: true, TextColor: #b7c9bb); }
    }
    Group { LayoutMode: Top; Anchor: (Width: 338);
     Label { Text: "TREE LOCATIONS   |   NORTH AT TOP"; Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb); }
     Group #Map { FlexWeight: 1; Background: $T.@Inset; }
    }
   }
   Label #GroveStatus { Anchor: (Height: 54, Bottom: 10); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #dec68d, Wrap: true); }
   Group { LayoutMode: Left; Anchor: (Height: 40, Bottom: 10);
    $C.@SecondaryTextButton #Choose { Text: "Choose ground with staff"; FlexWeight: 1; Anchor: (Right: 10); }
    $C.@SecondaryTextButton #Remove { Text: "Remove location"; Anchor: (Width: 190, Right: 10); }
    $C.@TextButton #Save { Text: "Save plan"; Anchor: (Width: 150); Visible: false; }
   }
   Group { LayoutMode: Left; Anchor: (Height: 60, Bottom: 8); Background: $T.@Inset; Padding: (Full: 8);
    ItemIcon #SeedIcon { Anchor: (Width: 40, Height: 40, Right: 10); }
    Group { LayoutMode: Top; FlexWeight: 1;
     Label #SeedTitle { Text: "FREE PLANTING"; Anchor: (Height: 20); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #dec68d); }
     Label #SeedCount { Anchor: (Height: 24); Style: (...$C.@DefaultLabelStyle, FontSize: 13, Wrap: true); }
    }
   }
   Group { LayoutMode: Left; Anchor: (Height: 36, Bottom: 6);
    $C.@TextButton #Activate { Text: "Start grove work"; FlexWeight: 1; Anchor: (Right: 10); }
    $C.@SecondaryTextButton #Release { Text: "Release edited tree"; FlexWeight: 1; Anchor: (Right: 10); Visible: false; }
    $C.@SecondaryTextButton #Refresh { Text: "Refresh"; Anchor: (Width: 120); }
   }
   Label #ModeHint { Anchor: (Height: 42); Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #b7c9bb, Wrap: true); }
  }
 }
}
$C.@BackButton {}
