$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560, Height: 620);

    #Title {
      Label #ToolKeybindsTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);
      FlexWeight: 1;

      Label #ToolKeybindsIntro {
        Anchor: (Bottom: 12);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #d8ccb8, FontSize: 13);
        Text: "";
      }

      Group #KeybindRowsScroll {
        LayoutMode: TopScrolling;
        FlexWeight: 1;
        Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #KeybindRows {
          LayoutMode: Top;
          Padding: (Bottom: 8);
        }
      }

      Label #ToolKeybindsStatus {
        Anchor: (Top: 8, Bottom: 8);
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #a8c8a8);
        Text: "";
      }

      Group #ToolKeybindsFooter {
        LayoutMode: Left;
        Anchor: (Top: 4);

        $C.@TextButton #ToolKeybindsSaveButton {
          Text: "";
          Anchor: (Width: 160, Height: 40);
        }

        $C.@SecondaryTextButton #ToolKeybindsResetButton {
          Text: "";
          Anchor: (Left: 10, Width: 180, Height: 40);
        }

        $C.@SecondaryTextButton #ToolKeybindsBackButton {
          Text: "";
          Anchor: (Left: 10, Width: 120, Height: 40);
        }
      }
    }
  }
}
