$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@PlotTabAnchor = Anchor(Width: 82, Height: 62, Right: 5, Bottom: -14);

@PlotCraftTabsStyle = TabNavigationStyle(
  TabStyle: (
    Default: (...$C.@TopTabStyle, Anchor: (...@PlotTabAnchor, Bottom: -8)),
    Hovered: (...$C.@TopTabStyle, Anchor: (...@PlotTabAnchor, Bottom: -3)),
    Pressed: (...$C.@TopTabStyle, Anchor: (...@PlotTabAnchor, Bottom: -6))
  ),
  SelectedTabStyle: (
    Default: (
      ...$C.@TopTabStyle,
      Anchor: (...@PlotTabAnchor, Bottom: 0),
      IconAnchor: (Width: 44, Height: 44),
      Overlay: "../Common/TabSelectedOverlay.png"
    )
  )
);

@PlotCommunitySubTabAnchor = Anchor(Width: 82, Height: 62, Right: 5, Top: -14);

@PlotCommunitySubTabStyle = TabStyleState(
  Background: "Common/ContainerPatch.png",
  Overlay: "Common/TabOverlay.png",
  IconAnchor: (Width: 44, Height: 44),
  Anchor: (...@PlotCommunitySubTabAnchor)
);

@PlotCommunitySubTabsStyle = TabNavigationStyle(
  TabStyle: (
    Default: (...@PlotCommunitySubTabStyle, Anchor: (...@PlotCommunitySubTabAnchor, Top: -8)),
    Hovered: (...@PlotCommunitySubTabStyle, Anchor: (...@PlotCommunitySubTabAnchor, Top: -3)),
    Pressed: (...@PlotCommunitySubTabStyle, Anchor: (...@PlotCommunitySubTabAnchor, Top: -6))
  ),
  SelectedTabStyle: (
    Default: (
      ...@PlotCommunitySubTabStyle,
      Anchor: (...@PlotCommunitySubTabAnchor, Top: 0),
      IconAnchor: (Width: 44, Height: 44),
      Overlay: "Common/TabSelectedOverlay.png"
    )
  )
);

@PlotPanelHeight = 600;
@PlotCraftContentPadding = 30;
@PlotCraftFooterHeight = 96;
@PlotListFooterGap = 8;
@PlotListHeight = @PlotPanelHeight - $C.@TitleHeight - @PlotCraftContentPadding - @PlotCraftFooterHeight - @PlotListFooterGap;

@SectionTitle = (FontSize: 12, TextColor: #7a8e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Start);

@ArrowBackStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #ffffff), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #5c6a78(0.45)), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Sounds: $Sounds.@ButtonsLight
);

@ArrowForwardStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #ffffff), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #5c6a78(0.45)), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Sounds: $Sounds.@ButtonsLight
);

@RefreshIconStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #ffffff), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Hovered: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Pressed: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Disabled: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #5c6a78(0.45)), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Sounds: $Sounds.@ButtonsLight
);

@ViewModeListStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../list.png", Border: 0, Color: #ffffff), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Hovered: (Background: PatchStyle(TexturePath: "../list.png", Border: 0, Color: #c5d0dc), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Pressed: (Background: PatchStyle(TexturePath: "../list.png", Border: 0, Color: #8fa0b0), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Disabled: (Background: PatchStyle(TexturePath: "../list.png", Border: 0, Color: #5c6a78(0.55)), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Sounds: $Sounds.@ButtonsLight
);

@ViewModeGridStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../grid.png", Border: 0, Color: #ffffff), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Hovered: (Background: PatchStyle(TexturePath: "../grid.png", Border: 0, Color: #c5d0dc), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Pressed: (Background: PatchStyle(TexturePath: "../grid.png", Border: 0, Color: #8fa0b0), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Disabled: (Background: PatchStyle(TexturePath: "../grid.png", Border: 0, Color: #5c6a78(0.55)), LabelStyle: (FontSize: 6, TextColor: #ffffff(0.01))),
  Sounds: $Sounds.@ButtonsLight
);

@ModerationTabIconLbl = (
  FontSize: 6,
  TextColor: #ffffff(0.01),
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@ModerationTabButtonStyle = (
  Default: (Background: (TexturePath: "../Common/Tab.png", Border: 0)),
  Hovered: (Background: (TexturePath: "../Common/Tab.png", Border: 0, Color: #c5d0dc)),
  Pressed: (Background: (TexturePath: "../Common/Tab.png", Border: 0, Color: #8fa0b0)),
  Disabled: (Background: (TexturePath: "../Common/Tab.png", Border: 0, Color: #5c6a78(0.45)))
);

@ModerationTabAnchor = Anchor(Width: 82, Height: 62, Bottom: -8);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group #PlotCraftRoot {
    LayoutMode: Center;

    Group #PanelsRow {
      LayoutMode: Left;

      Group #StyleFilterColumn {
        LayoutMode: Top;
        Anchor: (Width: 240, Right: 10);

        $C.@Container {
          Anchor: (Width: 240, Height: @PlotPanelHeight, Top: 56);

          #Title {
            Label #StyleFilterTitle {
              Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
              Padding: (Horizontal: 8);
              Text: "";
            }
          }

          #Content {
            LayoutMode: Top;
            Padding: (Full: 12);

            Group #FilterModeRow {
              LayoutMode: Left;
              Anchor: (Bottom: 10, Height: $C.@SmallButtonHeight);
              Visible: false;

              $C.@SmallSecondaryTextButton #FilterModeTheme {
                FlexWeight: 1;
                Anchor: (Right: 6);
                Padding: (Horizontal: 8);
                Text: "";
              }

              $C.@SmallSecondaryTextButton #FilterModeType {
                FlexWeight: 1;
                Padding: (Horizontal: 8);
                Text: "";
              }
            }

            Group #StyleFilterScroll {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              FlexWeight: 1;
              Anchor: (Height: @PlotPanelHeight - $C.@TitleHeight - 40);

              Group #StyleFilterRows {
                LayoutMode: Top;
                Padding: (Horizontal: 2, Vertical: 2);
              }
            }

            Group #DownloadThemeFooter {
              LayoutMode: Top;
              Anchor: (Top: 10, Height: $C.@SmallButtonHeight);
              Visible: false;

              $C.@SmallSecondaryTextButton #DownloadThemeButton {
                FlexWeight: 1;
                Padding: (Horizontal: 8);
                Text: "";
              }
            }
          }
        }
      }

      Group #LeftColumn {
        LayoutMode: Top;
        Anchor: (Width: 500, Right: 10);

        Group #PlotCraftTabRow {
          LayoutMode: Left;
          Anchor: (Height: 66, Left: 2, Right: 0);

          TabNavigation #PlotCraftTabs {
            Anchor: (Height: 66);
            Style: @PlotCraftTabsStyle;
            SelectedTab: "Core";

            TabButton {
              Icon: "../house_icon_256.png";
              TooltipText: "Core buildings";
              Id: "Core";
            }

            TabButton {
              Icon: "../decoration.png";
              TooltipText: "Decorations";
              Id: "Decorations";
            }

            TabButton {
              Icon: "../flags.png";
              TooltipText: "Festivals";
              Id: "Festivals";
            }

            TabButton {
              Icon: "../star.png";
              TooltipText: "Favorites";
              Id: "Favorites";
            }

            TabButton {
              Icon: "../group_icon_256.png";
              TooltipText: "Community";
              Id: "Community";
            }
          }

          Group {
            FlexWeight: 1;
          }

          Group #ModerationTabHost {
            LayoutMode: Full;
            Anchor: (...@ModerationTabAnchor, Vertical: 0);

            Group #ModerationTabSelected {
              Anchor: (Full: 0);
              LayoutMode: Full;
              Background: (TexturePath: "../Common/TabSelectedOverlay.png", Border: 0);
              Visible: false;
              HitTestVisible: false;
            }

            Button #ModerationTabButton {
              LayoutMode: Middle;
              Anchor: (Full: 0);
              Style: @ModerationTabButtonStyle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              TooltipText: "Moderate";

              AssetImage #ModerationTabIcon {
                Anchor: (Width: 44, Height: 44);
                AssetPath: "UI/Custom/cog.png";
                FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
                HitTestVisible: false;
              }
            }
          }
        }

        // Bottom community sub-tabs sit under the panel. Stack is tall enough that the tab
        // hit boxes stay inside the layout (not clipped), while the panel draws on top of the tuck.
        Group #CraftPanelStack {
          LayoutMode: Full;
          Anchor: (Width: 500, Height: @PlotPanelHeight, Top: -10);

          Group #CommunitySubTabsHost {
            LayoutMode: Left;
            Anchor: (Height: 66, Left: 2, Right: 0, Bottom: 0);
            Visible: false;

            TabNavigation #CommunitySubTabs {
              Anchor: (Height: 66);
              Style: @PlotCommunitySubTabsStyle;
              SelectedTab: "Buildings";

              TabButton {
                Icon: "../house_icon_256.png";
                TooltipText: "Buildings";
                Id: "Buildings";
              }

              TabButton {
                Icon: "../walls.png";
                TooltipText: "Wall styles";
                Id: "WallStyles";
              }

              TabButton {
                Icon: "../decoration.png";
                TooltipText: "Props";
                Id: "Props";
              }
            }
          }

          $C.@DecoratedContainer {
            Anchor: (Width: 500, Height: @PlotPanelHeight, Top: 0);

            #Title {
              Group {
                Label #PlotCraftTitleText {
                  Style: (...$C.@TitleStyle, HorizontalAlignment: Start);
                  Padding: (Left: 19, Right: 220);
                  Text: "";
                }

                $C.@HeaderSearch {}
              }
            }

            #Content {
              LayoutMode: Top;
              Padding: (Full: 14);

              Group #MarketplaceRefreshRow {
                LayoutMode: Left;
                Anchor: (Height: 36, Bottom: 6);

                Group #PageControls {
                  LayoutMode: Left;
                  Visible: false;

                  TextButton #MarketplacePagePrev {
                    Style: @ArrowBackStyle;
                    Anchor: (Width: 36, Height: 36, Right: 6);
                    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                    Text: " ";
                  }

                  Label #MarketplacePageLabel {
                    Style: (...$C.@DefaultLabelStyle, TextColor: #e8dcc8, FontSize: 15, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                    Anchor: (Width: 110, Height: 36, Right: 6);
                    Text: "";
                  }

                  TextButton #MarketplacePageNext {
                    Style: @ArrowForwardStyle;
                    Anchor: (Width: 36, Height: 36, Right: 8);
                    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                    Text: " ";
                  }
                }

                Group {
                  FlexWeight: 1;
                }

                $C.@DropdownBox #CommunitySort {
                  Anchor: (Width: 156, Height: 36, Right: 8);
                  Visible: false;
              }

              TextButton #MarketplaceRefreshButton {
                Style: @RefreshIconStyle;
                Anchor: (Width: 36, Height: 36, Right: 8);
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Text: " ";
                Visible: false;
              }

              TextButton #ViewModeList {
                Style: @ViewModeListStyle;
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Anchor: (Width: 28, Height: 28, Right: 6);
                Text: " ";
                TooltipText: "";
              }

              TextButton #ViewModeGrid {
                Style: @ViewModeGridStyle;
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Anchor: (Width: 28, Height: 28);
                Text: " ";
                TooltipText: "";
              }
            }

            Group #BuildingListScroll {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Anchor: (Height: @PlotListHeight, Bottom: @PlotListFooterGap);
              Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 8, Color: #1e2430(0.55));

              Group #BuildingRows {
                LayoutMode: Top;
                Padding: (Horizontal: 4, Vertical: 4);
              }

              Group #BuildingGridRows {
                LayoutMode: LeftCenterWrap;
                Padding: (Horizontal: 6, Vertical: 6);
                Visible: false;
              }
            }

            Label #CostLine {
              Style: (...$C.@DefaultLabelStyle, TextColor: #c8a060, Wrap: true, FontSize: 16);
              Anchor: (Bottom: 6);
              Text: "";
            }

            Label #FundsLine {
              Style: (...$C.@DefaultLabelStyle, TextColor: #8a8070, Wrap: true, FontSize: 15);
              Anchor: (Bottom: 10);
              Text: "";
            }

            Label #UnlockPointsLine {
              Style: (...$C.@DefaultLabelStyle, TextColor: #8a8070, Wrap: true, FontSize: 15);
              Anchor: (Bottom: 6);
              Text: "";
            }

            Group #CommunityActionRow {
              LayoutMode: Left;
              Anchor: (Bottom: 6);
              Visible: false;

              $C.@TextButton #LoadPreviewButton {
                Anchor: (Height: 32, Right: 6);
                FlexWeight: 1;
                Text: "";
              }

              $C.@TextButton #DownloadButton {
                Anchor: (Height: 32, Right: 6);
                FlexWeight: 1;
                Text: "";
              }

              $C.@TextButton #RemoveButton {
                Anchor: (Height: 32);
                FlexWeight: 1;
                Text: "";
              }
            }

            Group #ModerationActionRow {
              LayoutMode: Top;
              Anchor: (Bottom: 6);
              Visible: false;

              Group #ModerationActionRowTop {
                LayoutMode: Left;
                Anchor: (Bottom: 6);

                $C.@TextButton #ModerationLoadPreviewButton {
                  Anchor: (Height: 32, Right: 6);
                  FlexWeight: 1;
                  Text: "";
                }

                $C.@TextButton #ModerationCraftButton {
                  Anchor: (Height: 32);
                  FlexWeight: 1;
                  Text: "";
                }
              }

              Group #ModerationActionRowBottom {
                LayoutMode: Left;

                $C.@TextButton #ApproveButton {
                  Anchor: (Height: 32, Right: 6);
                  FlexWeight: 1;
                  Text: "";
                }

                $C.@TextButton #DenyButton {
                  Anchor: (Height: 32);
                  FlexWeight: 1;
                  Text: "";
                }
              }
            }

            $C.@TextButton #CraftButton {
              Anchor: (Height: 36);
              Text: "";
            }
          }
        }
        }
      }

      $C.@Container #PreviewBackdrop {
        Anchor: (Width: 480, Height: @PlotPanelHeight, Top: 56, Right: 10);

        #Title {
          Label #PreviewTitle {
            Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
            Padding: (Horizontal: 19);
            Text: "";
          }
        }

        #Content {
          LayoutMode: Top;

          Group #PreviewFrame {
            LayoutMode: Full;
            FlexWeight: 1;
            Anchor: (Bottom: 10);

            PrefabPreviewComponent #PrefabPreview {
              Anchor: (Full: 0);
              AllowDragYaw: true;
              AllowDragPitch: true;
              AllowZoom: true;
              AllowPan: true;
              ShowAnchor: true;
            }

            Group #PreviewLockOverlay {
              Visible: false;
              LayoutMode: Full;
              Anchor: (Full: 0);
              Background: #0a0d12(0.78);
              HitTestVisible: false;
            }

            Group #PreviewLockIconWrap {
              Visible: false;
              LayoutMode: Center;
              Anchor: (Full: 0);
              HitTestVisible: false;

              AssetImage #PreviewLockIcon {
                Anchor: (Width: 64, Height: 64);
                AssetPath: "UI/Custom/padlock.png";
              }
            }

            Label #PreviewPlaceholder {
              Visible: false;
              Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, TextColor: #96a9be, FontSize: 15, Wrap: true);
              Anchor: (Full: 0);
              Text: "";
            }
          }

          Group #VariantSection {
            LayoutMode: Top;
            Anchor: (Bottom: 4);
            Padding: (Horizontal: 10, Vertical: 8);
            Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 8, Color: #1e2430(0.55));

            Group #VariantHeader {
              LayoutMode: Left;
              Anchor: (Bottom: 8);

              Label #VariantSectionTitle {
                Style: (...@SectionTitle);
                Text: "";
              }

              Group {
                FlexWeight: 1;
              }

              Label #VariantIndex {
                Style: (...$C.@DefaultLabelStyle, TextColor: #96a9be, FontSize: 14, RenderBold: true, HorizontalAlignment: End);
                Text: "";
              }
            }

            Group #VariantRow {
              LayoutMode: Left;

              TextButton #VariantPrev {
                Style: @ArrowBackStyle;
                Anchor: (Width: 40, Height: 40, Right: 8);
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Text: " ";
              }

              Label #VariantName {
                Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, TextColor: #e8dcc8, FontSize: 17, Wrap: true);
                FlexWeight: 1;
                Anchor: (Vertical: 0);
                Text: "";
              }

              TextButton #VariantNext {
                Style: @ArrowForwardStyle;
                Anchor: (Width: 40, Height: 40, Left: 8);
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                Text: " ";
              }
            }
          }
        }
      }

      $C.@Container #BuildingInfoPanel {
        Anchor: (Width: 350, Height: @PlotPanelHeight, Top: 56);

        #Title {
          Label #BuildingInfoTitle {
            Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
            Padding: (Horizontal: 16);
            Text: "";
          }
        }

        #Content {
          LayoutMode: Top;
          Padding: (Full: 12);

          Group #BuildingInfoEmpty {
            LayoutMode: Center;
            FlexWeight: 1;

            Label #BuildingInfoEmptyText {
              Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, TextColor: #7a8e9c, FontSize: 15, Wrap: true);
              Anchor: (Horizontal: 14);
              Text: "";
            }
          }

          Group #BuildingInfoScroll {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            FlexWeight: 1;
            Visible: false;

            Group #BuildingInfoRows {
              LayoutMode: Top;
              Padding: (Right: 8, Bottom: 12);

              Label #InfoBuildingName {
                Style: (...$C.@DefaultLabelStyle, TextColor: #e8dcc8, FontSize: 22, RenderBold: true, Wrap: true);
                Anchor: (Bottom: 5);
                Text: "";
              }

              Label #InfoBuildingMeta {
                Style: (...$C.@DefaultLabelStyle, TextColor: #96a9be, FontSize: 13, Wrap: true);
                Anchor: (Bottom: 10);
                Text: "";
              }

              Label #InfoDescription {
                Style: (...$C.@DefaultLabelStyle, TextColor: #c5d0dc, FontSize: 14, Wrap: true);
                Anchor: (Bottom: 12);
                Text: "";
              }

              Group #InfoCountsAsSection {
                LayoutMode: Top;
                Anchor: (Bottom: 12);
                Visible: false;

                Label #InfoCountsAsTitle {
                  Style: (...@SectionTitle);
                  Anchor: (Bottom: 4);
                  Text: "";
                }

                Label #InfoCountsAsValue {
                  Style: (...$C.@DefaultLabelStyle, TextColor: #c5d0dc, FontSize: 14, Wrap: true);
                  Text: "";
                }
              }

              Group #InfoGoldCard {
                LayoutMode: Top;
                Padding: (Full: 9);
                Anchor: (Bottom: 12);
                Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 8, Color: #30291d(0.72));

                Label #InfoGoldTitle {
                  Style: (...@SectionTitle, TextColor: #c8a060);
                  Anchor: (Bottom: 4);
                  Text: "";
                }

                Label #InfoGoldValue {
                  Style: (...$C.@DefaultLabelStyle, TextColor: #f1cf75, FontSize: 16, RenderBold: true, Wrap: true);
                  Text: "";
                }
              }

              Label #InfoRequiredModsTitle {
                Style: (...@SectionTitle);
                Anchor: (Bottom: 6);
                Text: "";
              }

              Group #InfoRequiredModsRows {
                LayoutMode: Top;
                Anchor: (Bottom: 12);
              }

              Label #InfoMaterialsTitle {
                Style: (...@SectionTitle);
                Anchor: (Bottom: 6);
                Text: "";
              }

              Group #InfoMaterialRows {
                LayoutMode: Top;
              }
            }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
