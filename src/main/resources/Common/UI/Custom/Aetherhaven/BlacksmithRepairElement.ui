Button #Button {
  LayoutMode: Left;
  Padding: (Full: 6);
  Style: (
    Hovered: (
      Background: #000000(0.2),
    )
  );

  ItemIcon #Icon {
    Anchor: (Width: 32, Height: 32);
  }

  Label #Name {
    Padding: (Horizontal: 10, Vertical: 5);
    Style: (RenderBold: true);
    FlexWeight: 1;
  }

  Label #Cost {
    Anchor: (Width: 72);
    Padding: (Horizontal: 10, Vertical: 5);
    Style: (TextColor: #d4a832, HorizontalAlignment: End);
  }

  Label #Durability {
    Anchor: (Width: 100);
    Padding: (Horizontal: 10, Vertical: 5);
    Style: (TextColor: #ffffff(0.6), HorizontalAlignment: End);
  }

  Group {
    LayoutMode: Full;
    Anchor: (Height: 2);
    Background: #ffffff(0.6);
  }
}
