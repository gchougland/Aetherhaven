$C = "../Common.ui";
$C.@PageOverlay {
  LayoutMode: Middle;
  $C.@DecoratedContainer {
    Anchor: (Width: 650);
    #Title {
      Label #TransferTitle { Style: (...$C.@TitleStyle, HorizontalAlignment: Center); Text: ""; }
    }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);
      Label #Intro { Anchor: (Bottom: 18); Style: (...$C.@DefaultLabelStyle, Wrap: true); Text: ""; }
      Group #Options {
        LayoutMode: Top;
        Label #DestinationLabel { Anchor: (Bottom: 8); Style: $C.@DefaultLabelStyle; Text: ""; }
        $C.@DropdownBox #Destination { Anchor: (Height: 36, Bottom: 18); }
        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 14);
          $C.@CheckBox #Props {}
          Label #PropsLabel { Anchor: (Left: 12); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, Wrap: true, VerticalAlignment: Center); Text: ""; }
        }
        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 14);
          $C.@CheckBox #Buildings {}
          Label #BuildingsLabel { Anchor: (Left: 12); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, Wrap: true, VerticalAlignment: Center); Text: ""; }
        }
        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 14);
          $C.@CheckBox #Config {}
          Label #ConfigLabel { Anchor: (Left: 12); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, Wrap: true, VerticalAlignment: Center); Text: ""; }
        }
        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 14);
          $C.@CheckBox #Overwrite {}
          Label #OverwriteLabel { Anchor: (Left: 12); FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, Wrap: true, VerticalAlignment: Center); Text: ""; }
        }
      }
      Group #Confirmation {
        Visible: false;
        LayoutMode: Top;
        Label #ConfirmationText { Anchor: (Bottom: 20); Style: (...$C.@DefaultLabelStyle, Wrap: true); Text: ""; }
        Group {
          LayoutMode: Left;
          Anchor: (Height: 40, Bottom: 12);
          $C.@TextButton #Confirm { FlexWeight: 1; Anchor: (Right: 12); Text: ""; }
          $C.@CancelTextButton #Back { FlexWeight: 1; Text: ""; }
        }
      }
      Label #Status { Anchor: (Bottom: 14); Style: (...$C.@DefaultLabelStyle, Wrap: true); Text: ""; }
      $C.@TextButton #Review { Anchor: (Height: 40, Bottom: 12); Text: ""; }
      $C.@CancelTextButton #Close { Anchor: (Height: 40); Text: ""; }
    }
  }
}
