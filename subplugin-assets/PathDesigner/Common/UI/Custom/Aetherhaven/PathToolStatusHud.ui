@PathInfoRow0 = Group {
  LayoutMode: Top;
  Anchor: (Bottom: 6);
  Padding: (Left: 4);

  Label #Info0 {
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #b0b8c0, Wrap: true);
    Text: "";
  }
};

@PathInfoRow1 = Group {
  LayoutMode: Top;
  Anchor: (Bottom: 6);
