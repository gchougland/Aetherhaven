Group #PathToolStatusRoot {
  LayoutMode: Top;
  Anchor: (Top: 72, Left: 20, Width: 520);

  TabNavigation #PathToolModeTabs {
    Anchor: (Height: 48, Left: 4, Right: 0);
    Style: @PathToolTabsStyle;
    SelectedTab: "Place";

    TabButton {
      Icon: "../location.png";
      TooltipText: "Place";
      Id: "Place";
    }

    TabButton {
      Icon: "../move_icon_256.png";
      TooltipText: "Move";
      Id: "Move";
    }

    TabButton {
      Icon: "../rotate_clockwise_256.png";
      TooltipText: "Rotate";
      Id: "Rotate";
    }

    TabButton {
      Icon: "../bulldozer_icon_256.png";
      TooltipText: "Remove";
      Id: "Remove";
    }

    TabButton {
      Icon: "../filter.png";
      TooltipText: "Replace filter";
      Id: "ReplaceFilter";
    }

    TabButton {
      Icon: "../idea.png";
      TooltipText: "Style designer";
      Id: "StyleDesigner";
    }
  }

  $C.@DecoratedContainer {
    Anchor: (Width: 520, Top: 4);

    #Title {
      Label #PathToolHudTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 12);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 14, Right: 14, Top: 10, Bottom: 14);

      Label #ModeName {
        Visible: false;
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #b8d8ff, FontSize: 17, RenderBold: true);
        Anchor: (Bottom: 6);
      }

      Label #ModeHelp {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #dce4ec, FontSize: 14, Wrap: true);
        Anchor: (Bottom: 10);
      }

      Label #StyleLine {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8d0d8, FontSize: 15, Wrap: true);
        Anchor: (Bottom: 6);
      }
      Label #WidthLine {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8d0d8, FontSize: 15, Wrap: true);
        Anchor: (Bottom: 6);
      }
      Label #NodesLine {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8d0d8, FontSize: 15, Wrap: true);
        Anchor: (Bottom: 8);
      }

      Label #PlaceModeReminder {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #e85c5c, FontSize: 13, Wrap: true);
        Anchor: (Bottom: 10);
      }

      Group #ControlRows {
        LayoutMode: Top;

        Group #RowsTranslate {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
          @PathHotkeyRow3 {}
          @PathHotkeyRow4 {}
        }

        Group #RowsRotate {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
          @PathHotkeyRow3 {}
          @PathHotkeyRow4 {}
          @PathHotkeyRow5 {}
        }

        Group #RowsCommit {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
          @PathHotkeyRow3 {}
          @PathHotkeyRow4 {}
          @PathHotkeyRow5 {}
        }

        Group #RowsRemove {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
        }

        Group #RowsStyleDesigner {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
          @PathInfoRow0 {}
          @PathInfoRow1 {}
          @PathInfoRow2 {}
        }

        Group #RowsStyleDesignerEdit {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
          @PathInfoRow0 {}
          @PathInfoRow1 {}
          @PathInfoRow2 {}
        }

        Group #RowsReplaceFilter {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
          @PathHotkeyRow3 {}
          @PathHotkeyRow4 {}
          @PathInfoRow0 {}
        }

        Group #RowsReplaceFilterEdit {
          Visible: false;
          LayoutMode: Top;

          @PathHotkeyRow0 {}
          @PathHotkeyRow1 {}
          @PathHotkeyRow2 {}
          @PathHotkeyRow3 {}
          @PathHotkeyRow4 {}
          @PathInfoRow0 {}
        }
      }
    }
  }
}
