$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 440);

    #Title {
      Label #PathToolWidthTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #PreviewLabel {
        Style: (...$C.@DefaultLabelStyle, TextColor: #a8b8c8, FontSize: 13, Wrap: true);
        Anchor: (Bottom: 8);
        Text: "";
      }

      Group #PreviewRows {
        LayoutMode: Top;
        Anchor: (Bottom: 14);
      }

      Label #WidthLabel {
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8d0d8);
        Anchor: (Bottom: 4);
        Text: "";
      }

      Group #WidthSliderRow {
        LayoutMode: Left;
        Anchor: (Bottom: 16);

        $C.@Slider #WidthSlider {
          FlexWeight: 1;
          Anchor: (Right: 10, Height: 24);
          Min: 1;
          Max: 9;
          Value: 3;
        }

        Label #WidthValue {
          Anchor: (Width: 36);
          Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, RenderBold: true);
          Text: "";
        }
      }

      Group #Buttons {
        LayoutMode: Left;
        Anchor: (Top: 4);

        $C.@TextButton #ApplyButton {
          FlexWeight: 1;
          Anchor: (Right: 6);
          Text: "";
        }

        $C.@CancelTextButton #CancelButton {
          FlexWeight: 1;
          Text: "";
        }
      }
    }
  }
}

$C.@BackButton {}
