$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 420);

    #Title {
      Label #PathToolStyleListTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Hint {
        Anchor: (Bottom: 12);
        Style: (...$C.@DefaultLabelStyle, Wrap: true);
        Text: "";
      }

      Group #ListScroll {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 280);

        Group #Rows {
          LayoutMode: Top;
        }
      }

      Group #Buttons {
        LayoutMode: Left;
        Anchor: (Top: 12);

        $C.@TextButton #CreateButton {
          FlexWeight: 1;
          Anchor: (Right: 6);
          Text: "";
        }

        $C.@TextButton #EditButton {
          FlexWeight: 1;
          Anchor: (Right: 6);
          Text: "";
        }

        $C.@CancelTextButton #CancelButton {
          FlexWeight: 1;
          Text: "";
        }
      }
    }
  }
}

$C.@BackButton {}
