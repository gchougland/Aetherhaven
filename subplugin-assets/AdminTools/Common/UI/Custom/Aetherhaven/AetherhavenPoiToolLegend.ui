$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Top;

  Group #Legend {
    Anchor: (Top: 120, Left: 20, Width: 340);
    Background: #000000(0.55);
    Padding: (Left: 12, Right: 12, Top: 8, Bottom: 8);
    LayoutMode: Top;

    Label #Title {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendTitle";
      Style: (...$C.@DefaultLabelStyle, TextColor: #e8e8e8, FontSize: 15);
    }
    Label #LineMode {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendModeCycle";
      Style: (...$C.@DefaultLabelStyle, TextColor: #a8d4ff, FontSize: 13);
    }
    Label #LinePoiHeader {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendPoiHeader";
      Style: (...$C.@DefaultLabelStyle, TextColor: #e8e8e8, FontSize: 13);
    }
    Label #Line1 {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendPrimary";
      Style: (...$C.@DefaultLabelStyle, TextColor: #c8c8c8, FontSize: 13);
    }
    Label #Line2 {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendSecondaryPoi";
      Style: (...$C.@DefaultLabelStyle, TextColor: #c8c8c8, FontSize: 13);
    }
    Label #Line3 {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendUse";
      Style: (...$C.@DefaultLabelStyle, TextColor: #c8c8c8, FontSize: 13);
    }
    Label #LineSpawnHeader {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendSpawnHeader";
      Style: (...$C.@DefaultLabelStyle, TextColor: #e8e8e8, FontSize: 13);
    }
    Label #LineSpawn {
      Text: "%aetherhaven_items.aetherhaven.poiTool.legendSecondarySpawn";
      Style: (...$C.@DefaultLabelStyle, TextColor: #c8c8c8, FontSize: 13);
    }
  }
}
