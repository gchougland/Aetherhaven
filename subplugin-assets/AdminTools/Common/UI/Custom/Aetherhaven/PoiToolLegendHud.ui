$C = "../Common.ui";

Group #PoiToolLegendRoot {
  LayoutMode: Top;

  $C.@DecoratedContainer {
    Anchor: (Top: 88, Left: 20, Width: 400);

    #Title {
      Label #PoiToolHudTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 12);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 14, Right: 14, Top: 10, Bottom: 14);

      Group #ModeBlock {
        LayoutMode: Top;
        Anchor: (Bottom: 10);
        Label #ModeName {
          Text: " ";
          Style: (...$C.@DefaultLabelStyle, TextColor: #b8d8ff, FontSize: 17, RenderBold: true);
          Anchor: (Bottom: 6);
        }
        Label #ModeHelp {
          Text: " ";
          Style: (...$C.@DefaultLabelStyle, TextColor: #dce4ec, FontSize: 14, Wrap: true);
          Anchor: (Top: 2);
        }
      }

      Group #HintRows {
        LayoutMode: Top;
        Anchor: (Top: 2);
      }
    }
  }
}
