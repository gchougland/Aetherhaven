$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 520);

    #Title {
      Label #PoiMarkerConfigTitle {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #NeedHeader {
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8b8a0);
        Text: "";
        Anchor: (Bottom: 8);
      }

      Group #PresetRow {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        TextButton #PresetSleep { FlexWeight: 1; Anchor: (Right: 6, Height: 32); Text: ""; }
        TextButton #PresetEat { FlexWeight: 1; Anchor: (Right: 6, Height: 32); Text: ""; }
        TextButton #PresetSit { FlexWeight: 1; Anchor: (Right: 6, Height: 32); Text: ""; }
        TextButton #PresetWork { FlexWeight: 1; Anchor: (Height: 32); Text: ""; }
      }

      Label #PresetSummary {
        Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #a89878);
        Text: "";
        Anchor: (Bottom: 12);
      }

      Label #CapacityLabel {
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8b8a0);
        Text: "";
        Anchor: (Bottom: 4);
      }

      Slider #CapacitySlider {
        Anchor: (Bottom: 12, Height: 24);
        Min: 1;
        Max: 4;
        Step: 1;
        Value: 1;
      }

      Group #MountToggleRow {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        $C.@CheckBox #MountToggle {}

        Label #MountToggleLabel {
          Text: "";
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          Anchor: (Left: 11);
        }
      }

      Label #WorkActionLabel {
        Style: (...$C.@DefaultLabelStyle, TextColor: #c8b8a0);
        Text: "";
        Anchor: (Bottom: 4);
        Visible: false;
      }

      Group #WorkActionRow {
        LayoutMode: Left;
        Anchor: (Bottom: 12);
        Visible: false;

        TextButton #WorkNone { FlexWeight: 1; Anchor: (Right: 6, Height: 28); Text: ""; }
        TextButton #WorkMine { FlexWeight: 1; Anchor: (Right: 6, Height: 28); Text: ""; }
        TextButton #WorkChop { FlexWeight: 1; Anchor: (Height: 28); Text: ""; }
      }

      Group #ButtonRow {
        LayoutMode: Left;
        Anchor: (Top: 8);

        TextButton #ConfirmBtn {
          FlexWeight: 1;
          Anchor: (Right: 8, Height: 36);
          Text: "";
        }
        TextButton #CancelBtn {
          FlexWeight: 1;
          Anchor: (Height: 36);
          Text: "";
        }
      }
    }
  }
}
