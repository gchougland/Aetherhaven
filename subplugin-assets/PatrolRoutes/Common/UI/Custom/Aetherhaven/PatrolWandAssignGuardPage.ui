$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 480);

    #Title {
      Label #PatrolAssignTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Hint {
        Anchor: (Bottom: 12);
        Style: (...$C.@DefaultLabelStyle, Wrap: true);
        Text: "";
      }

      Group #OnlyUnassignedCheckbox {
        LayoutMode: Left;
        Anchor: (Bottom: 8);

        $C.@CheckBox #CheckBox {
        }

        Label #OnlyUnassignedLabel {
          Text: "";
          Anchor: (Right: 30, Left: 11);
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
        }
      }

      Group #ListScroll {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Height: 320);

        Group #Rows {
          LayoutMode: Top;
        }
      }
    }
  }
}

$C.@BackButton {}
