$C = "../Common.ui";
$T = "HandMirrorTheme.ui";
@Gold = #dec68d;
@Soft = #becadb;
@Heading = (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: @Gold, VerticalAlignment: Center);
// Inner width 1000: the worn slots are 400 wide, then a 16 gap, then 584 for the bag.
// The bag's panel has 6 of padding and keeps 12 free for its scrollbar, which leaves 560: two 276 wide cards and an 8 gap.
// The left column is a 26 heading over three 158 high slot cards with 10 between them: 520, the height the window leaves it.
$C.@PageOverlay {
  LayoutMode: Middle;
  $C.@DecoratedContainer #MirrorWindow {
    Anchor: (Width: 1040, Height: 658);
    #Title { Label #MirrorTitle { Text: ""; Style: (...$C.@TitleStyle, HorizontalAlignment: Center); } }
    #Content {
      LayoutMode: Top; Padding: (Full: 20);
      Group { LayoutMode: Left; FlexWeight: 1;
        Group #WornColumn { LayoutMode: Top; Anchor: (Width: 400, Right: 16);
          Label #WornHeading { Text: ""; Anchor: (Height: 26); Style: @Heading; }
          Group #WornSlots { LayoutMode: Top; }
        }
        Group #BagColumn { LayoutMode: Top; FlexWeight: 1;
          Group { LayoutMode: Left; Anchor: (Height: 26);
            Label #BagHeading { Text: ""; FlexWeight: 1; Style: @Heading; }
            Label #BagCount { Text: ""; Anchor: (Width: 160); Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9cb1b8, HorizontalAlignment: End, VerticalAlignment: Center); }
          }
          Label #BagHint { Text: ""; Anchor: (Height: 22, Bottom: 6); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: @Soft); }
          Group { FlexWeight: 1; Background: $T.@Panel; Padding: (Full: 6);
            Group #BagScroll { LayoutMode: TopScrolling; ScrollbarStyle: $C.@DefaultScrollbarStyle; Anchor: (Full: 0);
              Label #BagEmpty { Text: ""; Anchor: (Height: 64, Top: 12, Left: 12, Right: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 15, Wrap: true, TextColor: @Soft); Visible: false; }
              Group #BagRows { LayoutMode: Top; }
            }
          }
        }
      }
      Group { LayoutMode: Left; Anchor: (Height: 44, Top: 12);
        Label #MirrorNote { Text: ""; FlexWeight: 1; Anchor: (Right: 12); Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: @Gold, Wrap: true, VerticalAlignment: Center); }
        $C.@SecondaryTextButton #TakeOff { Text: ""; Anchor: (Width: 180, Height: 40, Right: 10); }
        $C.@TextButton #Done { Text: ""; Anchor: (Width: 160, Height: 40); }
      }
    }
  }
}
$C.@BackButton {}
