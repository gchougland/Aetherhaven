$C = "../Common.ui";

Group #Row {
  LayoutMode: Left;
  Anchor: (Bottom: 6);

  Group #IconFrame {
    Anchor: (Width: 40, Height: 40, Right: 8);
    LayoutMode: Full;
    Background: #1a2530;
    Padding: 2;

    AssetImage #Icon {
      Anchor: (Full: 0);
      FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    }
  }

  Label #Name {
    Style: (...$C.@DefaultLabelStyle, TextColor: #e8dcc8, Wrap: true, VerticalAlignment: Center);
    FlexWeight: 1;
    Anchor: (Right: 8);
  }

  $C.@SmallSecondaryTextButton #MinusButton {
    @Text = "";
    Anchor: (Width: 36, Right: 4);
  }

  $C.@TextField #CountField {
    Anchor: (Width: 52, Height: 32, Right: 4);
    PlaceholderText: "";
  }

  $C.@SmallSecondaryTextButton #PlusButton {
    @Text = "";
    Anchor: (Width: 36, Right: 4);
  }

  $C.@SmallSecondaryTextButton #RemoveButton {
    @Text = "";
    Anchor: (Width: 36);
  }
}
