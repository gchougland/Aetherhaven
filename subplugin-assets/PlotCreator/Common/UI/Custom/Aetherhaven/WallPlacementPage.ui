$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@IconLbl = (
  FontSize: 6,
  TextColor: #ffffff(0.01),
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@ArrowBright = #ffffff;
@ArrowDim = #5c6a78(0.5);

@IconUpOnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconUpOffStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #8a96a4), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #6d7a88), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconDownOnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconDownOffStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #8a96a4), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #6d7a88), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconBackOnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconBackOffStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #8a96a4), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #6d7a88), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconFwdOnStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: @ArrowBright), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconFwdOffStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #8a96a4), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #6d7a88), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: @ArrowDim), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconUpStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_up_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconDownStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_down_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconBackStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_back_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconFwdStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../arrow_forward_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconMinusStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../minus_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../minus_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../minus_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconPlusStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../add_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../add_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../add_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconZoomOutStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../zoom_out_256.png", Border: 0, Color: #5c6a78(0.85)), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconZoomInStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../zoom_in_256.png", Border: 0, Color: #5c6a78(0.85)), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);
@IconRotStyle = TextButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #ffffff), LabelStyle: (...@IconLbl)),
  Hovered: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #c5d0dc), LabelStyle: (...@IconLbl)),
  Pressed: (Background: PatchStyle(TexturePath: "../rotate_clockwise_256.png", Border: 0, Color: #8fa0b0), LabelStyle: (...@IconLbl)),
  Disabled: (Background: PatchStyle(TexturePath: "../Common/Buttons/Disabled.png", Border: 12), LabelStyle: (...@IconLbl)),
  Sounds: $Sounds.@ButtonsLight
);

@SummaryLabelStyle = (
  FontSize: 18,
  TextColor: #e8f0f4,
  RenderBold: true,
  Wrap: true,
  HorizontalAlignment: Start
);

@MutedBodyStyle = (
  FontSize: 14,
  TextColor: $C.@ColorGrayCaption,
  Wrap: true,
  HorizontalAlignment: Start
);

$C.@PageOverlay {
  LayoutMode: Top;
  Anchor: (Left: 16, Top: 28, Bottom: 80, Width: 480);

  $C.@DecoratedContainer {
    FlexWeight: 1;
    Anchor: (Width: 480, Top: 0, Bottom: 0);

    #Title {
      Label #WallPlacementTitle {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 19);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Anchor: (Top: $C.@TitleHeight, Bottom: 0);
      Padding: (Top: 14, Left: 14, Right: 14, Bottom: 44);

      Label #Summary {
        Anchor: (Bottom: 8, Width: 448);
        Style: (...@SummaryLabelStyle);
      }

      Label #Tips {
        Anchor: (Bottom: 10, Width: 448);
        Style: (...@MutedBodyStyle);
      }

      Group #EditGroup {
        LayoutMode: Top;
        Visible: false;
        Anchor: (Bottom: 10);

        Label #EditHint {
          Anchor: (Bottom: 8, Width: 448);
          Style: (...@MutedBodyStyle);
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 420);
          $C.@TextButton #EditContinueButton {
            Text: "";
            Anchor: (Width: 420, Height: 44);
          }
          $C.@TextButton #EditRemoveButton {
            Text: "";
            Anchor: (Top: 8, Width: 420, Height: 44);
          }
          $C.@CancelTextButton #EditCancelButton {
            Text: "";
            Anchor: (Top: 8, Width: 420, Height: 44);
          }
        }
      }

      Group #RemoveConfirmGroup {
        LayoutMode: Top;
        Visible: false;
        Anchor: (Bottom: 10);

        Label #RemoveConfirmText {
          Anchor: (Bottom: 8, Width: 448);
          Style: (...$C.@DefaultLabelStyle, Wrap: true, TextColor: #c49a6c);
        }

        Group {
          LayoutMode: Left;
          $C.@TextButton #RemoveConfirmButton {
            Text: "";
            FlexWeight: 1;
            Anchor: (Right: 6);
          }
          $C.@CancelTextButton #RemoveConfirmBackButton {
            Text: "";
            FlexWeight: 1;
            Anchor: (Left: 6);
          }
        }
      }

      Group #PieceTypeRow {
        LayoutMode: Left;
        Anchor: (Bottom: 10);
        TextButton #BtnPieceWall {
          Style: (...$C.@DefaultTextButtonStyle);
          Anchor: (Width: 140, Height: 44, Right: 8);
        }
        TextButton #BtnPieceGate {
          Style: (...$C.@DefaultTextButtonStyle);
          Anchor: (Width: 140, Height: 44, Right: 8);
        }
        TextButton #BtnPieceTower {
          Style: (...$C.@DefaultTextButtonStyle);
          Anchor: (Width: 140, Height: 44);
        }
      }

      Group #WallStyleRow {
        LayoutMode: Left;
        Anchor: (Bottom: 10);
        Visible: false;

        TextButton #BtnStylePrev {
          Style: @IconBackStyle;
          Anchor: (Width: 40, Height: 36, Right: 8);
          Padding: (Full: 0);
          Text: ".";
        }

        Label #WallStyleName {
          FlexWeight: 1;
          Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "";
        }

        TextButton #BtnStyleNext {
          Style: @IconFwdStyle;
          Anchor: (Width: 40, Height: 36, Left: 8);
          Padding: (Full: 0);
          Text: ".";
        }
      }

      Group #BirdsEyeZoomRow {
        LayoutMode: Left;
        Anchor: (Bottom: 10);

        TextButton #BtnZoomIn {
          Style: @IconZoomInStyle;
          Anchor: (Width: 34, Height: 34, Right: 6);
          Padding: (Full: 0);
          Text: ".";
        }

        $C.@FloatSlider #BirdsEyeDistanceSlider {
          Anchor: (Width: 200, Height: 5, Right: 8);
          Min: 12.0;
          Max: 48.0;
          Value: 22.0;
        }

        TextButton #BtnZoomOut {
          Style: @IconZoomOutStyle;
          Anchor: (Width: 34, Height: 34, Right: 8);
          Padding: (Full: 0);
          Text: ".";
        }

        Label #BirdsEyeDistanceValue {
          Anchor: (Width: 34);
          Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "22";
        }
      }

      Group #CameraPlotRow {
        LayoutMode: Left;
        Anchor: (Bottom: 12);

        Group #ViewSideColumn {
          LayoutMode: Top;
          FlexWeight: 1;

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            TextButton #BtnViewZm {
              Style: @IconUpOffStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            Group {
              LayoutMode: Left;
              TextButton #BtnViewXm {
                Style: @IconBackOffStyle;
                Anchor: (Width: 44, Height: 40);
                Padding: (Full: 0);
                Text: ".";
              }
              AssetImage #ViewSidePadIcon {
                Anchor: (Width: 36, Height: 36, Left: 8);
                AssetPath: "UI/Custom/camera_icon_256.png";
              }
              TextButton #BtnViewXp {
                Style: @IconFwdOffStyle;
                Anchor: (Width: 44, Height: 40, Left: 8);
                Padding: (Full: 0);
                Text: ".";
              }
            }
          }

          Group {
            LayoutMode: Center;
            TextButton #BtnViewZp {
              Style: @IconDownOffStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }
        }

        Group #NudgePadColumn {
          LayoutMode: Top;
          FlexWeight: 1;
          Visible: false;

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            TextButton #BtnNudgeZm {
              Style: @IconUpStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            Group {
              LayoutMode: Left;
              TextButton #BtnNudgeXm {
                Style: @IconBackStyle;
                Anchor: (Width: 44, Height: 40);
                Padding: (Full: 0);
                Text: ".";
              }
              AssetImage #NudgePadIcon {
                Anchor: (Width: 36, Height: 36, Left: 8);
                AssetPath: "UI/Custom/move_icon_256.png";
              }
              TextButton #BtnNudgeXp {
                Style: @IconFwdStyle;
                Anchor: (Width: 44, Height: 40, Left: 8);
                Padding: (Full: 0);
                Text: ".";
              }
            }
          }

          Group {
            LayoutMode: Center;
            TextButton #BtnNudgeZp {
              Style: @IconDownStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }
        }

        Group #PlotMovePad {
          LayoutMode: Top;
          FlexWeight: 1;

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            TextButton #BtnExpandZm {
              Style: @IconUpStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }

          Group {
            LayoutMode: Center;
            Anchor: (Bottom: 22);
            Group {
              LayoutMode: Left;
              TextButton #BtnExpandXm {
                Style: @IconBackStyle;
                Anchor: (Width: 44, Height: 40);
                Padding: (Full: 0);
                Text: ".";
              }
              AssetImage #ExpandPadIcon {
                Anchor: (Width: 36, Height: 36, Left: 8);
                AssetPath: "Icons/ItemsGenerated/Aetherhaven_Token_Wall.png";
              }
              TextButton #BtnExpandXp {
                Style: @IconFwdStyle;
                Anchor: (Width: 44, Height: 40, Left: 8);
                Padding: (Full: 0);
                Text: ".";
              }
            }
          }

          Group {
            LayoutMode: Center;
            TextButton #BtnExpandZp {
              Style: @IconDownStyle;
              Anchor: (Width: 44, Height: 40);
              Padding: (Full: 0);
              Text: ".";
            }
          }
        }
      }

      Group #RowYBack {
        LayoutMode: Center;
        Anchor: (Bottom: 8);
        Group {
          LayoutMode: Left;
          TextButton #BtnYm {
            Style: @IconMinusStyle;
            Anchor: (Width: 40, Height: 40);
            Padding: (Full: 0);
            Text: ".";
          }
          TextButton #BtnYp {
            Style: @IconPlusStyle;
            Anchor: (Width: 40, Height: 40, Left: 8);
            Padding: (Full: 0);
            Text: ".";
          }
          TextButton #BtnRotate {
            Style: @IconRotStyle;
            Visible: false;
            Anchor: (Width: 44, Height: 40, Left: 10);
            Padding: (Full: 0);
            Text: ".";
          }
          $C.@TextButton #BackButton {
            Text: "";
            Anchor: (Width: 100, Height: 40, Left: 12);
          }
        }
      }

      Group {
        FlexWeight: 1;
      }

      Group #RowActions {
        LayoutMode: Top;
        Anchor: (Top: 8, Width: 420);
        $C.@TextButton #PlaceButton {
          Text: "";
          Anchor: (Width: 420, Height: 48);
          Padding: (Horizontal: 10, Vertical: 10);
        }
        $C.@CancelTextButton #CancelButton {
          Text: "";
          Anchor: (Top: 8, Width: 420, Height: 48);
          Padding: (Horizontal: 10, Vertical: 10);
        }
      }
    }
  }
}

$C.@BackButton {}
