$C = "../Common.ui";

Group #PlotCreatorStatusRoot {
  LayoutMode: Top;

  $C.@DecoratedContainer {
    Anchor: (Top: 88, Left: 20, Width: 460);

    #Title {
      Label #PlotCreatorHudTitleText {
        Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        Padding: (Horizontal: 12);
        Text: "";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Left: 14, Right: 14, Top: 10, Bottom: 14);

      Label #StepName {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #b8d8ff, FontSize: 17, RenderBold: true);
        Anchor: (Bottom: 6);
      }

      Label #StepHelp {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #dce4ec, FontSize: 14, Wrap: true);
        Anchor: (Bottom: 10);
      }

      Label #DetailLine {
        Text: " ";
        Style: (...$C.@DefaultLabelStyle, TextColor: #a89878, FontSize: 13, Wrap: true);
        Anchor: (Bottom: 8);
        Visible: false;
      }

      Group #ControlRows {
        LayoutMode: Top;
      }
    }
  }
}
