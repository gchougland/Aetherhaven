$C = "../Common.ui";

@SectionLabelStyle = (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #7a8e9c, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Start);
// The card fills the board's card row (QuestBoardPage.ui @BoardCardRowHeight).
@QuestCardHeight = 560;
@QuestCardWidth = 344;
// Text column: the card less its outer (4) and inner (12) padding on both sides.
@QuestCardInnerWidth = @QuestCardWidth - 32;
@QuestHeaderMinHeight = 64;
@QuestHeaderIconSize = 52;
@QuestHeaderIconGap = 10;
// An explicit title width keeps the wrapped title's height known, so the header can grow with it.
@QuestTitleWidth = @QuestCardInnerWidth - @QuestHeaderIconSize - @QuestHeaderIconGap - @QuestHeaderIconSize;
@QuestCardOuter = (TexturePath: "../Common/ContainerFullPatch.png", Border: 20);
@RankBadgeBg = (TexturePath: "../Common/InputBoxSelected.png", Border: 12, Color: #ffffff);

Group #QuestBoardCard {
  LayoutMode: Top;
  Anchor: (Width: @QuestCardWidth, Height: @QuestCardHeight, Right: 12);
  Background: @QuestCardOuter;
  Padding: (Full: 4);

  Group #CardInner {
    LayoutMode: Top;
    FlexWeight: 1;
    Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 10, Color: #141c28(0.97));
    Padding: (Full: 12);

    Group #CompletedOnly {
      LayoutMode: Middle;
      FlexWeight: 1;
      Visible: false;

      Label #CompletedBanner {
        Style: (...$C.@DefaultLabelStyle, FontSize: 20, TextColor: #a8b8a0, RenderBold: true, HorizontalAlignment: Center, Wrap: true);
        Padding: (Horizontal: 12);
        Text: "";
      }
    }

    Group #CardBody {
      LayoutMode: Top;
      FlexWeight: 1;

      // No fixed height: a title that wraps to three lines makes the header taller instead of
      // running into the description. The portrait frame keeps it at least @QuestHeaderMinHeight.
      Group #CardHeader {
        LayoutMode: Left;
        Anchor: (Bottom: 14);

        Group #PortraitFrame {
          LayoutMode: Middle;
          Anchor: (Width: @QuestHeaderIconSize, Height: @QuestHeaderMinHeight, Right: @QuestHeaderIconGap);

          AssetImage #Portrait {
            Anchor: (Width: @QuestHeaderIconSize, Height: @QuestHeaderIconSize);
          }
        }

        Group #TitleWrap {
          LayoutMode: Middle;
          Anchor: (Width: @QuestTitleWidth);

          Label #QuestTitle {
            Style: (...$C.@DefaultLabelStyle, FontSize: 21, TextColor: #f4e8c8, RenderBold: true, Wrap: true, HorizontalAlignment: Center);
            Padding: (Horizontal: 8);
            Text: "";
          }
        }

        Group #RankBadgeFrame {
          LayoutMode: Middle;
          Anchor: (Width: @QuestHeaderIconSize, Height: @QuestHeaderIconSize);
          Background: @RankBadgeBg;

          AssetImage #QuestRankIcon {
            Anchor: (Width: 32, Height: 32);
          }
        }
      }

      // Everything below the header is as tall as its content, so a long description pushes the
      // rest down. If a card still holds more than fits, this area scrolls instead of overlapping
      // the footer.
      Group #CardDetails {
        LayoutMode: TopScrolling;
        FlexWeight: 1;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Label #QuestDescription {
          Style: (...$C.@DefaultLabelStyle, FontSize: 17, TextColor: #b8b0a0, Wrap: true);
          Anchor: (Bottom: 14);
          Text: "";
        }

        Label #RequestedLabel {
          Style: @SectionLabelStyle;
          Anchor: (Bottom: 6, Top: 8);
          Text: "";
        }

        // Wraps to a second row when a quest asks for more items than fit across the card.
        Group #ItemRow {
          LayoutMode: LeftWrap;
          Anchor: (Bottom: 6);
        }

        Label #ObjectiveText {
          Style: (...$C.@DefaultLabelStyle, FontSize: 17, TextColor: #c8b8a0, Wrap: true);
          Anchor: (Bottom: 12);
          Visible: false;
          Text: "";
        }

        Label #RewardLabelHeader {
          Style: @SectionLabelStyle;
          Anchor: (Bottom: 4, Top: 6);
          Text: "";
        }

        Group #RewardItemsRow {
          LayoutMode: LeftWrap;
          Anchor: (Bottom: 4);
          Visible: false;
        }

        Label #RewardReputationLine {
          Style: (...$C.@DefaultLabelStyle, FontSize: 16, TextColor: #a8c8d8, Wrap: true);
          Anchor: (Top: 6, Bottom: 6);
          Visible: false;
          Text: "";
        }
      }
    }

    Group #CardFooter {
      LayoutMode: Top;
      Anchor: (Height: 76);

      Group #FooterTop {
        LayoutMode: Left;
        Anchor: (Bottom: 6, Height: 26);

        Label #DaysLeft {
          Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #8a9eb0, HorizontalAlignment: Start);
          FlexWeight: 1;
          Text: "";
        }

        $C.@SecondaryTextButton #ProfileButton {
          Anchor: (Width: 120, Height: 26);
          Visible: false;
          Text: "";
        }
      }

      $C.@TextButton #ActionButton {
        Anchor: (Height: 40);
        Text: "";
      }
    }
  }

  Label #EmptyHint {
    Style: (...$C.@DefaultLabelStyle, FontSize: 20, TextColor: #6a7580, Wrap: true, HorizontalAlignment: Center);
    Anchor: (Vertical: 0);
    Visible: false;
    Text: "";
  }
}
