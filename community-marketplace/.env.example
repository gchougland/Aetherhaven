# Local development only — copy to .env (never commit .env)
# On Railway, set these in the service Variables UI instead.

PORT=3847
NODE_ENV=development

# Required in production (Railway). Generate with: openssl rand -hex 32
API_KEY=
SESSION_SECRET=

# Comma-separated Hytale profile UUIDs for website admin moderation
ADMIN_HYTALE_UUIDS=

# Persistent storage (use /data on Railway with a mounted volume)
DATA_DIR=./data

# Optional — auto-set on Railway from RAILWAY_PUBLIC_DOMAIN
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# Hytale OIDC (required for website Sign in with Hytale)
HYTALE_OIDC_ISSUER=https://connect.accounts.hytale.com
HYTALE_OIDC_CLIENT_ID=
HYTALE_OIDC_CLIENT_SECRET=
HYTALE_OIDC_REDIRECT_URI=http://localhost:3847/auth/callback
