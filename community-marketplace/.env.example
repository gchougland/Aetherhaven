# Local development only — copy to .env (never commit .env)
# On Railway, set these in the service Variables UI instead.

PORT=3847
NODE_ENV=development

# Required in production (Railway). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated Hytale profile UUIDs for website admin moderation
ADMIN_HYTALE_UUIDS=

# Optional — machine-to-machine admin API (curl); not used by the mod
# API_KEY=

# Optional submission rate limits
# SUBMISSION_MAX_PER_PLAYER_PER_DAY=10
# SUBMISSION_MAX_PER_IP_PER_HOUR=30

# Optional support bundle uploads (/aetherhaven support upload)
# SUPPORT_BUNDLE_MAX_BYTES=52428800
# SUPPORT_BUNDLE_RETENTION_DAYS=30

# Optional — Discord webhooks (leave unset to disable)
# Admin channel: new submissions awaiting approval
# DISCORD_PENDING_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Public channel: newly approved buildings
# DISCORD_APPROVED_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Persistent storage (use /data on Railway with a mounted volume)
DATA_DIR=./data

# Prefab 3D viewer assets (output of: npm run sync-hytale-assets)
# Local default: ./web/hytale-assets — on Railway use the volume, e.g. /data/hytale-assets
# HYTALE_ASSETS_DIR=./web/hytale-assets
# Optional Chromium for auto preview screenshots on new submissions
# CHROMIUM_PATH=

# Production (Railway): PUBLIC_BASE_URL=https://aetherhaven.net
# Production OAuth redirect: https://aetherhaven.net/auth/callback
PUBLIC_BASE_URL=http://localhost:3847

# Hytale OIDC (required for website Sign in with Hytale)
HYTALE_OIDC_ISSUER=https://connect.accounts.hytale.com
HYTALE_OIDC_CLIENT_ID=
HYTALE_OIDC_CLIENT_SECRET=
HYTALE_OIDC_REDIRECT_URI=http://localhost:3847/auth/callback

# Optional — Google AdSense (public browse + wiki banners). Off until ADS_ENABLED=true.
# ADS_ENABLED=false
# ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# ADSENSE_SLOT_BROWSE=
# ADSENSE_SLOT_WIKI=
